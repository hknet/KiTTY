; KiTTY sample configuration file
;
; This file is intentionally inert: every option is commented out.
; To use an option, copy this file to kitty.ini, then uncomment only
; the setting(s) you want to change. Do not rename this example in
; installed MSI folders unless you intentionally want a live config there.
;
; Values shown here mirror KiTTY built-in defaults where practical.

[ConfigBox]

; dblclick: what a double-click on a saved session does
;    - open: load it and open it in this window (like the Open button)
;    - start: launch it in a new window and keep the configuration box open (like the Start button)
;dblclick=open

; defaultsettings: when no, KiTTY does not auto-create a 'Default Settings'
;    session AND hides it from the saved-session list in the config box. It still
;    works as the template for a new session (loaded by name), it just isn't
;    listed. Default yes (create it and show it, like stock PuTTY).
;defaultsettings=yes

; categoryexpand: how many levels of the config-box Category tree are expanded
;    on open. Default (unset, or all/full) = fully expanded; a number expands only
;    that deep - 1 = top categories only (stock PuTTY), 2 = one level of subtrees,
;    and so on.
;categoryexpand=all

; filter: enable/disable filter in saved sessions selection box
;filter=yes

; height: the number of visible lines in the saved-sessions list (default 16 = stock fit)
;height=16

; loadlastsession: when yes (default), the configuration box opens pre-filled with
;    the session used last. When no, it opens on 'Default Settings' with the caret
;    already in 'Host Name (or IP address)' - quick connect: type a host, press
;    Enter, and every connection starts from the same known configuration instead
;    of inheriting whatever was used before.
;loadlastsession=yes

; noexit: if yes, closing a window that ran a connected session starts a fresh
;    instance showing the configuration box, so you land back in the session
;    picker. A window that never connected (e.g. the config box itself was
;    cancelled) exits normally, and nothing respawns during system shutdown.
;noexit=no

; proxyselection: show the named-proxy chooser in the Session panel.
;   auto (default) = show once any named proxy is defined; yes = always; no = never
;proxyselection=auto

; windowheight: force the configuration window to an explicit height, in pixels
;    (scaled for your display DPI). Default 0 = off, so the window is sized from
;    [ConfigBox] height instead. This is a blunt override - it resizes only the
;    outer window, not the inner controls - so [ConfigBox] height is usually what
;    you want. The 800 below is only an example value.
;windowheight=0



[KiTTY]

; antiidle: string sent to the server periodically to keep the connection alive.
;    Default (unset/empty) = disabled. \k08 sends a backspace; pick a sequence the
;    remote ignores. Interval is set by antiidledelay (seconds).
;antiidle=\k08\

; antiidledelay: time delay between two sending
;antiidledelay=60

; autoreconnect: enable/disable the automatic reconnection feature
;autoreconnect=yes

; backgroundimage: enable/disable the background image feature
;bgimage=no

; bcdelay: delay in MILLISECONDS between each character in every automatic
;    keyboard send (autocommand, login script, user commands, send-text boxes).
;    Default 0 = off. Set a few ms (e.g. 3) for hosts that drop characters
;    when input arrives too fast.
;bcdelay=0

; commanddelay: delay in SECONDS between two lines of the automatic start
;    command script (Connection/Data/Command setting). 0.05 = 50 ms; minimum
;    enforced 0.005.
;commanddelay=0.05

; conf: enable/disable the automatic creation of the default configuration file
;conf=yes

; configdir: set the configuration directory
;    In portable mode it is the place where to find settings files directories: Sessions, SshHostKeys, ...
;    Usually it is the same directory where kitty.exe is
;configdir=

; browsedirectory: base directory for portable/session file browsing; normally auto-detected
;browsedirectory=

; Folders: legacy session-folder cache, managed by KiTTY; edit only for recovery/debugging
;Folders=

; RootFolderLabel: what the configuration box's folder selector calls the root
;    session list (the sessions that are in no folder). Display only - that
;    folder is always stored as "Default", so renaming the label changes no
;    session and no saved setting. Normally set from the config box itself:
;    select the root list, type a new name over its label, press Rename; typing
;    the built-in name back restores it. Like Folders, this is stored in
;    whichever backend your save mode uses - the registry in registry mode,
;    this file in file/dir mode.
;RootFolderLabel=All sessions (root)

; cryptsalt: set salt mode for password encryption 
;cryptsalt=1

; CtHelperPath: the full path to the cthelper.exe binary (Wrapper for Cygwin feature)
;CtHelperPath=

; ctrltab: switch between PuTTY windows with CTRL+Tab
;ctrltab=yes

; debug: for debug purpose only
;debug=no

; downloaddir: this is the local directory where files are downloaded with the pscp integration
;downloaddir=

; uploaddir: default remote directory used by the pscp upload integration
;uploaddir=.

; fileextension: the extension for session settings files in portable mode
;fileextension=.ktx

; hyperlink: enable/disable the hyperlink feature
;hyperlink=yes

; icon: enable/disable the icon management feature (a particular icon for specific session)
;icon=yes

; iconfile: point to a file where internal icons are located
;iconfile=kitty.exe

; initdelay: initial delay in seconds before automatic sending of password, or auto command
;initdelay=2.0

; KiClassName: the Windows window-class name KiTTY registers, which also selects
;    which registry hive it reads/writes sessions in. Default (unset): KiTTY's own
;    class and hive (Software\kapper.net\KiTTY). Set to PuTTY to use stock PuTTY's
;    window class AND PuTTY's hive (Software\SimonTatham\PuTTY) - handy to share
;    sessions with an installed PuTTY, or for host tools that key off the "PuTTY"
;    window class. This is NOT the default; leave it unset for normal use.
;KiClassName=PuTTY

; modalerrors: show connection errors as modal pop-up boxes instead of inline in the terminal (upstream cyd01/KiTTY #548). Default no (inline, non-trapping).
;modalerrors=no

; modalnewhostkeyconfirmation: how to confirm an UNKNOWN (first-seen) host key.
;    Default yes = classic modal dialog box. no = OpenSSH-style prompt in the
;    terminal; type "yes" to accept and cache the key, "once" to connect without
;    caching it, anything else cancels.
;modalnewhostkeyconfirmation=yes

; modalchangedhostkeyconfirmation: how to handle a CHANGED host key (differs from
;    the cached one). Default yes = classic modal dialog box (you can Accept to
;    update the cache). no = in-terminal "double opt-in": first type "yes" to
;    accept the new key for this connection, then - because KiTTY cannot verify a
;    plain SSH key's authenticity - you are asked separately whether to REPLACE
;    the stored key for future connections, which requires typing the exact word
;    "confirmed" (a plain "yes" is re-asked, not accepted). Decline the replace
;    and you connect this once with the old key kept (asked again next time).
;modalchangedhostkeyconfirmation=yes

; modalweakkeyconfirmation: how to confirm a weak crypto algorithm / weak cached
;    host key (below the warning threshold). Default yes = classic modal dialog
;    box. no = OpenSSH-style prompt in the terminal; type "yes" to accept.
;    Note: all three of these prompts fall back to an in-terminal error + abort
;    if they occur during an already-authenticated session (a rekey), where no
;    inline prompt is possible.
;modalweakkeyconfirmation=yes

; mouseshortcuts: enable/disable mouse shortcuts
;mouseshortcuts=yes

; numberoficons: total number of internal icons
;numberoficons=45

; internaldelay: legacy internal delay in milliseconds for some automated actions
;internaldelay=10

; pastesize: paste size limit (number of characters). Above the limit a confirmation is requested. (0 means unlimited)
;pastesize=0

; proxychainmax: how many chained SSH proxies (jump hosts) a connection may use
;    before it is refused with an error. Stops a proxy chain that loops back on
;    itself from hanging. Default 5; values below 1 are ignored.
;proxychainmax=5

; PSCPPath: the full path to the pscp.exe (or kscp.exe) binary
;PSCPPath=

; pscpdir: legacy fallback directory containing pscp.exe/kscp.exe (prefer PSCPPath)
;pscpdir=

; pscpport: port used by pscp integration; use * to reuse the current session port
;pscpport=22

; ReconnectDelay: the delay before trying to reconnect automatically (in seconds)
;ReconnectDelay=5

; readonly: open KiTTY in read-only configuration mode
;readonly=no

; restrictacl: apply the restricted process ACL to every KiTTY process, so you
;    do not have to add -restrict-acl to each shortcut target. It denies other
;    processes running as you the access rights used to read or write another
;    process's memory - the same hardening as the -restrict-acl switch - and it
;    propagates to the windows KiTTY spawns for you (config-box Start/Open,
;    duplicate session, the launcher). kageant reads it too, so the process
;    holding your loaded private keys is covered by the same setting.
;    kittygen is not: pass it -restrict-acl if you want it hardened.
;    Off by default, because it also blocks
;    legitimate uses, notably screen readers and other accessibility tools.
;    yes is the only value that does anything: a process cannot un-restrict
;    itself, so restrictacl=no does not lift a restriction already applied by
;    -restrict-acl. If the ACL cannot be applied, KiTTY reports the error and
;    exits rather than run unprotected.
;    Unlike most keys here, this one is read from kitty.ini ONLY, never from
;    the registry: the usual order consults the registry first, which would
;    let a stale registry value silently cancel a restrictacl=yes written here.
;restrictacl=no

; sav: base path for the registry backup (a full export of KiTTY's hive). Each
;    save writes a FRESH timestamped file next to it, <base>-YYYYMMDD-HHMMSS<ext>,
;    so the filename always reflects when that copy was written. Default base is
;    %APPDATA%\KiTTY\kittynew.sav (i.e. the files are kittynew-YYYYMMDD-HHMMSS.sav)
;    - NOT kitty.sav, so an old 0.76 KiTTY's backup is never touched. A legacy
;    value ending in kitty.sav or kitty084.sav is ignored so this default takes
;    over; uncomment with a real path to force one.;    Backups left by earlier 0.84 builds (kitty-YYYYMMDD-HHMMSS.sav, from a
;    defect that made the default kitty.sav after all) are still READ for a
;    first-run restore; new ones are only ever written under the name above.
;sav=

; savbackupcount: in registry mode, how many timestamped backups to keep - the
;    newest N are kept, older ones deleted. Default 5, max 50; 0 disables backups.
;savbackupcount=5

; savemode: specify the save mode for sessions settings
;    Allowed values are:
;    - registry : to save sessions into windows registry
;    - file : to save sessions into one unique file (currently not maintained)
;    - dir : to save sessions into files in the directory structure
;savemode=registry

; portablebackupcount: in portable dir mode, keep this many timestamped backups
;    under Backups\kitty-portable-YYYYMMDD-HHMMSS. 0 disables portable backups.
;portablebackupcount=5

; PortablePasswordProtection: at-rest protection for passwords saved in portable
;    (savemode=dir) session files. Only applies in portable mode; in registry
;    mode saved passwords are always protected with Windows DPAPI.
;    Allowed values are:
;    - master : protect saved passwords with a master password (default). Only
;               the password fields are encrypted, the rest of the session file
;               stays readable. Copy the files and know the master password to
;               use them on another machine. KiTTY asks you to set the master
;               password the first time it saves a password; -masterpwfile
;               supplies it without a prompt.
;    - dpapi  : protect saved passwords with Windows DPAPI, i.e. this Windows
;               account on this PC. No master password is created and KiTTY
;               never asks for one - so unattended runs need no switch at all -
;               but the passwords do NOT travel: copied to another PC or account
;               they cannot be decrypted. Cannot be combined with -masterpwfile.
;    - legacy : store saved passwords unprotected (plain text) for explicit
;               compatibility/automation/audit setups. INSECURE - anyone who can
;               read the files gets the passwords.
;PortablePasswordProtection=master

; WarnLegacyPasswordUpgrade: in portable mode, warn before a save re-encrypts a
;    password stored in the old unprotected format into the new protected format
;    (old KiTTY releases cannot read the new format). Set to no to skip the
;    warning and re-encrypt silently; the warning dialog can also set this.
;WarnLegacyPasswordUpgrade=yes

; scriptfilefilter: file-dialog filter for local script files.
;    Default: (*.ksh,*.sh)|*.ksh;*.sh|SQL files (*.sql)|*.sql|All files (*.*)|*.*|
;    The example line below narrows it to all files only:
;scriptfilefilter=All files (*.*)|*.*|

; scriptmode: master switch for the RuTTY script engine (send a script file
;    line by line, with wait-for-prompt/halt-on patterns). no = disable the
;    engine entirely: the session auto-script does not run and the
;    "Send a script file" menu entry refuses with a notice.
;scriptmode=yes

; shortcuts: enable/disable keyboard shortcuts
;shortcuts=yes

; size: append the live terminal size, e.g. [24x80] (rows x columns), to the
;    window title. Updates as you resize; hidden while maximized. Needs
;    wintitle=yes (the default).
;size=no

; slidedelay: delay in seconds before automatic image switching in slideshow mode
;    0 means no automatic slide, waiting for keyboard event
;slidedelay=0

; shrinkbitmap: shrink large background images to fit the terminal area
;shrinkbitmap=no

; sshversion: the client version string KiTTY announces to the SSH server.
;    Default (unset): PuTTY-KiTTY - KiTTY's own identifier. Some servers reject a
;    non-standard client-version string; set this to a common OpenSSH banner so
;    KiTTY looks like a stock client. Use a current OpenSSH version, e.g.:
;sshversion=OpenSSH_10.0

; transparency: enable/disable the transparency feature
;transparency=yes

; userpasssshnosave: if yes, SSH password will not be saved internally (and can't be reused automatically) 
;userpasssshnosave=no

; winroll: enable/disable the rolling feature (rolling into the title bar)
;winroll=yes

; WinSCPPath: the full path to the winscp.exe binary: 
;WinSCPPath=

; winscpdir: legacy fallback directory containing WinSCP.exe (prefer WinSCPPath)
;winscpdir=

; wintitle: enable KiTTY's window-title decorations: the live size suffix
;    (size=yes) and the (PROTECTED) / (ONTOP) status markers. no = plain stock
;    titles. Unlike classic KiTTY the title text is never parsed, only
;    decorated - the old remote title-command channel stays removed.
;wintitle=yes

; zmodem: enable/disable zmodem feature (to send/receive files with sz/rz commands)
;zmodem=yes



[Shortcuts]

; Shortcuts: definition for the menu shortcuts keys

; (re)send automatic command (default is SHIFT+F12)
;autocommand=

; Change settings ...
;changesettings=

; Clear scrollback
;clearscrollback=

; Clear log file
;clearlogfile=

; Close and restart current session
;closerestart=

; run a local command (default is CONTROL+F5)
;command=

; Copy all window buffers to clipboard
;copyall=

; Open a duplicate window (with same session settings)
;duplicate=

; open text editor connected to the main window (default is SHIFT+F2)
;editor=

; open text editor with clipboard content, connected to the main window (default is CONTROL+SHIFT+F2)
;editorclipboard=

; Show event log
;eventlog=

; Switch font to black on white colors
;fontblackandwhite=

; Decrease font size
;fontdown=

; Switch font to negative colors
;fontnegative=

; Increase font size
;fontup=

; Switch to full screen
;fullscreen=

; receive a remote file with pscp.exe: the full path must be selected in clipboard (default is CONTROL+F4)
;getfile=

; change the background image (default is CONTROL+F11)
;imagechange=

; special command box (default is CONTROL+F8)
;input=

; special command with multi-line editor (default is SHIFT+F8)
;inputm=

; Repeat key exchange
;keyexchange=

; New session ...
;opennew=

; Inherit New Session: a new configuration box carrying the current settings.
;    In quick connect (see [ConfigBox] loadlastsession) the host name comes with
;    them, selected and ready to be edited into the next machine; otherwise the
;    box opens without a host.
;opennewcurrent=

; Print current clipboard content (default if SHIFT+F7)
;print=

; Print all window buffer content (default is F7)
;printall=

; Protect the window, disable keyboard and mouse input (default is CONTROL+F9)
;protect=

; Reset terminal
;resetterminal=

; Roll-up the window into the title bar (default is CONTROL+F12)
;rollup=

; Load a local script and run it remotely (default is CONTROL+F2)
;script=

; Send a local file with pscp.exe (default is CONTROL+F3)
;sendfile=

; Show current port forwarding definition (default is SHIFT+F6)
;showportforward=

; Enable or disable logging (default is SHIFT+F5)
;switchlogmode=

; Send the window to the system tray (default is CONTROL+F6)
;tray=

; Switch to embedded image viewer (default SHIFT+F11)
;viewer=

; Switch to always visible (default is CONTROL+F7)
;visible=

; Start WinSCP (default is SHIFT+F3)
;winscp=



[Print]

; height: characters size (Printing)
;height=100

; maxline: maximum number of lines per page
;maxline=60

; maxchar: maximum number of characters per line
;maxchar=85



; funkeys: which function-key mode a session starts with when it does not
; already carry one of its own. Saved sessions are NOT affected - they store the
; mode they were saved with; change those on Terminal -> Keyboard.
;   xterm216   what to set if F13-F24 "do nothing". On a modern keyboard those
;              keys ARE Shift+F1..F12, and this is the only mode that says so in
;              the way terminfo and modern hosts expect (xterm's kf13 is
;              CSI 1;2P, kf24 is CSI 24;2~ - the F-key with the shift modifier
;              encoded). Every other mode folds Shift into the key number, so
;              Shift+F1 arrives as F11 and F13 upwards cannot be produced.
;   tilde      ESC[n~ - PuTTY's own default, and what you get if this is unset
;   linux | xtermr6 | vt400 | vt100p | sco   the remaining Keyboard-panel modes
;funkeys=xterm216

; namedproxy: how a NAMED PROXY's Host field is read, when the proxy itself
; does not say (each proxy can, in the proxy editor: "That host is:").
;   sessionorhostname  the title of a saved session first, then a hostname.
;                      This is what PuTTY has always done, and the DEFAULT.
;   hostname           a hostname, full stop.
; Why you might set "hostname": with the old rule, a jump host that happens to
; share its name with a saved session loads THAT SESSION as the jump-host
; configuration - including whatever proxy the session itself carries - so a
; connection can silently run through an unrelated proxy. Setting it per proxy
; is the precise fix; this is the blanket one.
;namedproxy=sessionorhostname

[Launcher]

; reload: enable session list reload on each menu respawn
;reload=yes

; exitwithworkplace: close the launcher again when workplace proxy mode is
; switched off (default yes). Only applies to a launcher that the mode itself
; started, by switching the mode on when none was running - a launcher you
; started yourself always keeps running, because it is also your session list
; and your hotkeys. Set no to keep the started one too.
;exitwithworkplace=yes

; noticeseconds: how long the workplace proxy mode notice stays on screen
; (default 15). It is a window of our own rather than a tray balloon precisely
; so that this is ours to set: Windows has ignored the requested balloon
; duration since Vista, and a balloon cannot carry the mode's colour.
;noticeseconds=15


[Agent]

; kageant (the SSH agent) settings. kageant finds this file on its own:
; %KITTY_INI_FILE%, else kitty.ini/putty.ini next to kageant.exe, else
; %APPDATA%\KiTTY\kitty.ini / %APPDATA%\PuTTY\putty.ini. When the file
; says [KiTTY] savemode=file or savemode=dir, the ini is the authoritative
; store: the tray toggles write back here and the registry is never touched
; (portable mode). A portable folder counts even without the savemode
; line: with savemode absent, a Sessions folder or KiTTYState file next
; to the ini also makes it authoritative. Otherwise (savemode=registry,
; or absent with no such layout) the registry stays authoritative and
; these keys act as first-run defaults only.

; askconfirmation: prompt before a loaded key may sign:
;   yes  = every key use
;   auto = only keys whose comment contains "confirmation" (default)
;   no   = never - also disables the per-key comment prompts (automation)
;askconfirmation=auto

; messageonkeyusage: tray balloon naming the key after each signature
;messageonkeyusage=yes

; loadonstartup: re-add the remembered keys when kageant starts, added
; encrypted (passphrase asked on first use). Toggle it from the kageant
; tray menu ("Load keys on startup"); the key list below is managed for you.
;loadonstartup=no

; startupkey1, startupkey2, ...: the remembered key files, in order. Paths
; under this install folder are stored relative to it (so they travel); a
; trailing ",encrypted" loads that key deferred. kageant writes these when
; you load keys with loadonstartup on - you normally do not edit them by hand.
;startupkey1=keys\id_ed25519.ppk,encrypted

; keylistgeometry / keylistcolumns: the key-list window's remembered
; position/size and column widths. kageant writes these itself when the
; window is moved, resized or closed - not knobs to edit by hand.
;keylistgeometry=
;keylistcolumns=


[FontFallback]

; Font fallback: when the terminal font is missing a character (box drawing,
; Nerd Font icons, CJK, symbols...), KiTTY probes a list of fallback fonts
; and draws that character from the first font that has it. Cell widths are
; unchanged; only the glyph's source font differs. Rendering is plain GDI,
; so emoji come out monochrome. NB: section and key names in this file are
; case-sensitive.

; active: master switch for the whole feature
;active=yes

; fallback: comma-separated list of font names to try, in order, before the
; built-in defaults (Cascadia Mono, Cascadia Code, Segoe UI Symbol, Segoe UI
; Emoji, Segoe UI Historic, Microsoft YaHei UI, Microsoft JhengHei UI,
; Yu Gothic UI, Malgun Gothic). Naming a built-in just promotes it. Fonts
; that are not installed are skipped. Start the list with ! to REPLACE the
; built-in defaults instead.
;fallback=Symbols Nerd Font Mono,JetBrains Mono
;fallback=!MyOnlyFont1,MyOnlyFont2

; override: force a Unicode range (or single codepoint, hex) to a specific
; font regardless of probe results; multiple entries separated by ;
;override=E000-F8FF:Symbols Nerd Font Mono;1F600-1F64F:Segoe UI Emoji

; log: off|error|warn|info|debug|trace - troubleshooting log, written to
; fontfallback.log next to kitty.exe (debug/trace are high volume)
;log=off

; logfile: alternative path for the log file
;logfile=
