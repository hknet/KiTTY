; KiTTY sample configuration file
;
; This file is intentionally inert: every option is commented out.
; To use an option, copy this file to kitty.ini, then uncomment only
; the setting(s) you want to change. Do not rename this example in
; installed MSI folders unless you intentionally want a live config there.
;
; Values shown here mirror KiTTY built-in defaults where practical.

[ConfigBox]

; dblclick: what a double-click on a saved session does
;    - open: load it and open it in this window (like the Open button)
;    - start: launch it in a new window and keep the configuration box open (like the Start button)
;dblclick=open

; defaultsettings: when no, 'Default Settings' is hidden from the saved-session
;    list in the config box. The session itself is always there either way - it
;    is the template every new session starts from - so this only decides
;    whether you can see and click it. Default yes (shown, like stock PuTTY).
;    Note it is also the way into quick connect, where you type a host instead
;    of picking a session: you get there by loading Default Settings once. Hide
;    the row and that route is gone unless you set loadlastsession=no below.
;    https://github.com/hknet/KiTTY/blob/kitty-0.84/FEATURES.md#quick-connect-type-a-host-instead-of-picking-a-session
;defaultsettings=yes

; categoryexpand: how many levels of the config-box Category tree are expanded
;    on open. Default (unset, or all/full) = fully expanded; a number expands only
;    that deep - 1 = top categories only (stock PuTTY), 2 = one level of subtrees,
;    and so on.
;categoryexpand=all

; filter: with yes (the default), typing in the Saved Sessions NAME BOX narrows
;    the list below to sessions matching what you typed. no leaves the box as a
;    plain name field and the list always shows everything, like stock PuTTY.
;    Typing directly into the list is Windows' own first-letter jump and is not
;    affected either way.
;    Two keys go with it, from anywhere in the configuration box:
;      Ctrl+F  jump to the Session panel and put the cursor in that name box,
;              with what is already there selected so you can type over it.
;              It searches within the folder currently selected.
;      Ctrl+G  the same, but drops the folder filter back to the root list
;              first - "search everywhere", for finding a session when you
;              do not remember which folder it is in.
;    Neither loads, moves or saves anything, and neither is affected by
;    [KiTTY] shortcuts.
;filter=yes

; height: the number of visible lines in the saved-sessions list (default 16 = stock fit)
;height=16

; loadlastsession: when yes (default), the configuration box opens pre-filled with
;    the session used last. When no, it opens on 'Default Settings' with the caret
;    already in 'Host Name (or IP address)' - quick connect: type a host, press
;    Enter, and every connection starts from the same known configuration instead
;    of inheriting whatever was used before.
;loadlastsession=yes

; noexit: if yes, closing a window that ran a connected session starts a fresh
;    instance showing the configuration box, so you land back in the session
;    picker. A window that never connected (e.g. the config box itself was
;    cancelled) exits normally, and nothing respawns during system shutdown.
;noexit=no

; proxyselection: show the named-proxy chooser in the Session panel.
;   auto (default) = show once any named proxy is defined; yes = always; no = never
;   Where you DEFINE one in the first place depends on this setting: with yes
;   the chooser is always in the Session panel and carries an Edit button next
;   to it. With auto the chooser stays hidden until a definition exists, so the
;   way in is Connection > Proxy > "Edit named proxies...". no hides both, and
;   nothing in the GUI can then create or edit a definition.
;proxyselection=auto

; windowheight: force the configuration window to an explicit height, in pixels
;    (scaled for your display DPI). Default 0 = off, so the window is sized from
;    [ConfigBox] height instead. This is a blunt override - it resizes only the
;    outer window, not the inner controls - so [ConfigBox] height is usually what
;    you want. Set a pixel value, e.g. 800, to force it.
;windowheight=0



[KiTTY]

; antiidle: string sent to the server periodically to keep the connection alive.
;    Default (unset/empty) = disabled. \k08 sends a backspace; pick a sequence the
;    remote ignores. Interval is set by antiidledelay (seconds).
;antiidle=\k08\

; antiidledelay: time delay between two sending
;antiidledelay=60

; autoreconnect: reconnect a session by itself when the link drops, retrying
;    while the network is away. This is one of the premiere features users
;    start using KiTTY for - a session disconnect is no longer a manual job to
;    reconnect but solved by KiTTY for the user. On by default; see
;    ReconnectDelay for how long it waits between attempts.
;autoreconnect=yes

; backgroundimage: enable/disable the background image feature
;bgimage=no

; bcdelay: delay in MILLISECONDS between each character in every automatic
;    keyboard send (autocommand, login script, user commands, send-text boxes).
;    Default 0 = off. Set a few ms (e.g. 3) for hosts that drop characters
;    when input arrives too fast.
;bcdelay=0

; commanddelay: delay in SECONDS between two lines of the automatic start
;    command script (Connection/Data/Command setting). 0.05 = 50 ms; minimum
;    enforced 0.005.
;commanddelay=0.05

; conf: `no` stops KiTTY creating and maintaining its own files - kitty.ini is
;   not auto-created, and neither the kitty.sav backup nor the portable-folder
;   backups are written. Only `no` does anything: `conf=yes` is ignored rather
;   than being a way to switch the behaviour back on. It is not remembered
;   either - drop the line and the next start behaves normally.
;   Yes, an option that says "write no configuration file" living IN the
;   configuration file contradicts itself. Noted - and it still does what it
;   advertises: no further writes to those files. If you want no kitty.ini at
;   all, put the value in the registry instead - a string value conf = no
;   under HKCU\Software\kapper.net\KiTTY - and delete kitty.ini. Outside
;   portable mode the registry is read first, so it is honoured from there.
;conf=yes

; configdir: where the settings directories live - Sessions, SshHostKeys and
;    the rest. Portable mode uses it; by default it is the directory kitty.exe
;    sits in.
;    It does NOT move kitty.ini. This file has to be found before anything in
;    it can be read, so KiTTY is already holding it by the time it learns where
;    configdir points - kitty.ini stays where it was.
;    Removing the setting later does not move anything back either: your
;    sessions, host keys and stored keys stay in that directory and KiTTY stops
;    looking there, so they simply disappear from the list. Before you unset or
;    change it, use "Export all..." in the configuration box (Session panel),
;    then change the setting, then "Import all..." - that carries everything
;    across instead of stranding it.
;configdir=

; browsedirectory: base directory for portable/session file browsing; normally auto-detected
;browsedirectory=

; Folders: legacy session-folder cache, managed by KiTTY; edit only for recovery/debugging
;Folders=

; RootFolderLabel: what the configuration box's folder selector calls the root
;    session list. That list is not "the sessions in no folder" - it is ALL
;    of them: picking the root switches the folder filter off, so sessions
;    filed in folders stay listed too. Which is why the built-in label says
;    "All sessions". Display only - that
;    folder is always stored as "Default", so renaming the label changes no
;    session and no saved setting. Normally set from the config box itself:
;    select the root list, type a new name over its label, press Rename; typing
;    the built-in name back restores it. Like Folders, this is stored in
;    whichever backend your save mode uses - the registry in registry mode,
;    this file in file/dir mode.
;RootFolderLabel=All sessions (root)

; cryptsalt: set salt mode for password encryption 
;cryptsalt=1

; CtHelperPath: the full path to the cthelper.exe binary (Wrapper for Cygwin feature)
;CtHelperPath=

; ctrltab: allow Ctrl+Tab to switch between open KiTTY windows. This is the
;    master switch only - it does not turn the feature on by itself. Each
;    session also has its own "Switch KiTTY windows with Ctrl + TAB" box in
;    Window > Behaviour, which is off until you tick it, and that box is only
;    offered while this is yes. no hides the box and disables the key; the
;    -noctrltab command-line switch does the same for one window.
;ctrltab=yes

; debug: extra tracing in the Event Log - saved-session lookups, the automatic
;    command, key remappings, the internal editor, and the pscp / WinSCP
;    command lines actually run. The password those command lines carry is
;    blanked in the log, but the host, user, paths and switches are not, so
;    read a debug log before you send it to anyone.
;    It also enables /passwd, which shows this session's password and copies
;    it to the clipboard; without debug mode that command is treated as plain
;    text and sent to the host instead. /debug turns all of this on and off at
;    runtime, so it does not have to live in this file.
;debug=no

; downloaddir: this is the local directory where files are downloaded with the pscp integration
;downloaddir=

; uploaddir: default remote directory used by the pscp upload integration
;uploaddir=.

; fileextension: the extension for session settings files in portable mode
;fileextension=.ktx

; hyperlink: enable/disable the hyperlink feature
;hyperlink=yes

; iconfile: point to a file where internal icons are located
;iconfile=kitty.exe

; initdelay: initial delay in seconds before automatic sending of password, or auto command
;initdelay=2.0

; KiClassName: the Windows window-class name KiTTY registers, which also selects
;    which registry hive it reads/writes sessions in. Default (unset): KiTTY's own
;    class and hive (Software\kapper.net\KiTTY). Set to PuTTY to use stock PuTTY's
;    window class AND PuTTY's hive (Software\SimonTatham\PuTTY) - handy to share
;    sessions with an installed PuTTY, or for host tools that key off the "PuTTY"
;    window class. This is NOT the default; leave it unset for normal use.
;KiClassName=PuTTY

; modalerrors: show connection errors as modal pop-up boxes instead of inline in the terminal (upstream cyd01/KiTTY #548). Default no (inline, non-trapping).
;modalerrors=no

; modalnewhostkeyconfirmation: how to confirm an UNKNOWN (first-seen) host key.
;    Default yes = classic modal dialog box. no = OpenSSH-style prompt in the
;    terminal; type "yes" to accept and cache the key, "once" to connect without
;    caching it, anything else cancels.
;modalnewhostkeyconfirmation=yes

; modalchangedhostkeyconfirmation: how to handle a CHANGED host key (differs from
;    the cached one). Default yes = classic modal dialog box (you can Accept to
;    update the cache). no = in-terminal "double opt-in": first type "yes" to
;    accept the new key for this connection, then - because KiTTY cannot verify a
;    plain SSH key's authenticity - you are asked separately whether to REPLACE
;    the stored key for future connections, which requires typing the exact word
;    "confirmed" (a plain "yes" is re-asked, not accepted). Decline the replace
;    and you connect this once with the old key kept (asked again next time).
;modalchangedhostkeyconfirmation=yes

; modalweakkeyconfirmation: how to confirm a weak crypto algorithm / weak cached
;    host key (below the warning threshold). Default yes = classic modal dialog
;    box. no = OpenSSH-style prompt in the terminal; type "yes" to accept.
;    Note: all three of these prompts fall back to an in-terminal error + abort
;    if they occur during an already-authenticated session (a rekey), where no
;    inline prompt is possible.
;modalweakkeyconfirmation=yes

; mouseshortcuts: enable/disable mouse shortcuts
;mouseshortcuts=yes

; internaldelay: how long KiTTY pauses, in milliseconds, while it types for
;    you - between the lines of a multi-line send, and around each
;    synthesised keystroke that carries Ctrl/Shift/Alt. It paces the login
;    and automatic commands, \n breaks in the send-text boxes, user-command
;    menu entries and remapped keys. Default 10, minimum 1.
;    Raise it if a host drops characters out of a scripted or pasted block -
;    a slow link or a shell that echoes lazily needs more than 10 ms per
;    line. It has no effect on ordinary typing or on paste.
;internaldelay=10

; pastesize: warn before a large paste into the terminal. When the clipboard
;    holds more than this many characters, KiTTY names the count and the
;    limit and asks before sending anything - and the default answer is No,
;    so a stray Enter cancels the paste instead of flooding the shell.
;    The default is 5120 characters - about 5 KB, the same threshold Windows
;    Terminal warns at. 0 switches the warning off entirely. It counts
;    characters rather than lines, and judges only the size: what the
;    clipboard actually contains is not examined.
;    Note this key is read from the registry first (outside portable mode), so
;    if a pastesize value ever lands there, changing the line here has no
;    effect until you delete the registry value.
;pastesize=5120

; proxychainmax: how many chained SSH proxies (jump hosts) a connection may use
;    before it is refused with an error. Stops a proxy chain that loops back on
;    itself from hanging. Default 5; values below 1 are ignored.
;proxychainmax=5

; namedproxy: how a named proxy's Host field is read when the proxy entry
;    itself does not say:
;      sessionorhostname = the title of a saved session first, then a
;                          hostname (the default - what PuTTY has always
;                          done, and existing configurations may rely on it)
;      hostname          = a hostname, full stop. Guards against a jump host
;                          that happens to share a name with a saved session
;                          silently dragging that session's whole config in.
;    A proxy entry that says for itself overrides this.
;namedproxy=sessionorhostname

; funkeys: the default function-key mode for sessions that do not carry one,
;    spelled as the Keyboard panel spells the modes: tilde, linux, xtermr6,
;    vt400, vt100p, sco, xterm216. "xterm216" is the one worth setting - it
;    is the only mode in which Shift+F1..F12 mean F13..F24 the way terminfo
;    and every modern host expect.
;funkeys=xterm216

; verifyagent: a signed KiTTY checks, once per terminal window, whether the
;    program answering its SSH agent requests is a verified KiTTY/kageant
;    build, and warns when it is not. Set no if you deliberately run stock
;    Pageant, the Windows OpenSSH agent or another agent. Also a checkbox:
;    Connection -> SSH -> Auth (an application-wide setting, not per session).
;verifyagent=yes

; WorkplaceProxy / WorkplaceMinutes: the workplace-proxy-mode droplists'
;    remembered LAST selection (which proxy, for how long), shared between
;    the config box and the launcher menu so both offer the same thing next
;    time. KiTTY writes these itself - not knobs to edit by hand, and NOT
;    the mode's state: arming lives only in the running launcher.
;WorkplaceProxy=
;WorkplaceMinutes=240

; PSCPPath: the full path to the file-copy helper - kscp.exe, or PuTTY's
;    pscp.exe - used by drag-and-drop upload and the Send/Get file commands.
;    You do not normally set this: KiTTY looks for the tool at startup and
;    writes what it found back here. It searches, in order:
;      1. this key, if it still points at a file that exists
;      2. the pscpdir directory, kscp.exe first, then pscp.exe
;      3. kscp.exe beside kitty.exe - the usual answer, since kscp ships
;         with KiTTY and lives in the same folder
;      4. %ProgramFiles%\PuTTY\pscp.exe
;      5. pscp.exe beside kitty.exe
;    A value naming a file that has gone away is dropped and the search runs
;    again, so moving KiTTY does not leave it pointing at nothing. Set it by
;    hand only to force a particular binary.
;PSCPPath=

; pscpdir: legacy fallback directory containing pscp.exe/kscp.exe (prefer PSCPPath)
;pscpdir=

; pscpport: the port kscp/pscp connects to for file transfer. Leave it unset
;    and the transfer follows the SESSION's port - a host on 2222 transfers on
;    2222, no second place to keep in step. * says the same thing explicitly.
;    Give a number only to pin transfers to one port regardless of the session.
;    (The old "22" shown here was wrong: unset has never meant 22.)
;pscpport=*

; ReconnectDelay: the delay before trying to reconnect automatically (in seconds)
;ReconnectDelay=5

; readonly: refuse to write to the CONFIGURATION FILE side of the settings.
;    With yes, KiTTY will not write or delete entries in kitty.ini, will not
;    create kitty.ini if it is missing, will not create the store's
;    directories, and will not remove a legacy plaintext password it finds
;    in the file. The configuration box says so instead of failing quietly.
;    Not the same as conf=no, which is about KiTTY maintaining its OWN files
;    (auto-creating kitty.ini, the kitty.sav and portable backups). readonly
;    is the broader "do not write", and it covers deletes and directory
;    creation as well.
;    ⚠ Two things it does NOT do, despite the name: saved SESSIONS can still
;    be written - they go through the session store, not this path - and in
;    registry mode global settings are still written to the registry. Today
;    it protects the ini file, not everything KiTTY stores.
;readonly=no

; restrictacl: apply the restricted process ACL to every KiTTY process, so you
;    do not have to add -restrict-acl to each shortcut target. It denies other
;    processes running as you the access rights used to read or write another
;    process's memory - the same hardening as the -restrict-acl switch - and it
;    propagates to the windows KiTTY spawns for you (config-box Start/Open,
;    duplicate session, the launcher). kageant reads it too, so the process
;    holding your loaded private keys is covered by the same setting.
;    kittygen is not: pass it -restrict-acl if you want it hardened.
;    Off by default, because it also blocks
;    legitimate uses, notably screen readers and other accessibility tools.
;    Worth knowing before an upgrade: an in-place MSI install will NOT reopen
;    your sessions while this is on. Windows' Restart Manager cannot inspect
;    a restricted process, so the installer closes those windows and cannot
;    put them back. That is the hardening working as intended, not a fault in
;    the installer - the whole point is that other processes running as you
;    cannot reach into KiTTY, and the Restart Manager is one of them.
;    yes is the only value that does anything: a process cannot un-restrict
;    itself, so restrictacl=no does not lift a restriction already applied by
;    -restrict-acl. If the ACL cannot be applied, KiTTY reports the error and
;    exits rather than run unprotected.
;    Unlike most keys here, this one is read from kitty.ini ONLY, never from
;    the registry: the usual order consults the registry first, which would
;    let a stale registry value silently cancel a restrictacl=yes written here.
;restrictacl=no

; sav: base path for the registry backup (a full export of KiTTY's hive). Each
;    save writes a FRESH timestamped file next to it, <base>-YYYYMMDD-HHMMSS<ext>,
;    so the filename always reflects when that copy was written. Default base is
;    %APPDATA%\KiTTY\kittynew.sav (i.e. the files are kittynew-YYYYMMDD-HHMMSS.sav)
;    - NOT kitty.sav, so an old 0.76 KiTTY's backup is never touched. A legacy
;    value ending in kitty.sav or kitty084.sav is ignored so this default takes
;    over; uncomment with a real path to force one.;    Backups left by earlier 0.84 builds (kitty-YYYYMMDD-HHMMSS.sav, from a
;    defect that made the default kitty.sav after all) are still READ for a
;    first-run restore; new ones are only ever written under the name above.
;sav=

; savbackupcount: in registry mode, how many timestamped backups to keep - the
;    newest N are kept, older ones deleted. Default 5, max 50; 0 disables backups.
;savbackupcount=5

; savemode: specify the save mode for sessions settings
;    Allowed values are:
;    - registry : to save sessions into windows registry
;    - file : to save sessions into one unique file (currently not maintained)
;    - dir : to save sessions into files in the directory structure
;savemode=registry

; portablebackupcount: in portable dir mode, keep this many timestamped backups
;    under Backups\kitty-portable-YYYYMMDD-HHMMSS. 0 disables portable backups.
;portablebackupcount=5

; PortablePasswordProtection: at-rest protection for passwords saved in portable
;    (savemode=dir) session files. Only applies in portable mode; in registry
;    mode saved passwords are always protected with Windows DPAPI.
;    Allowed values are:
;    - master : protect saved passwords with a master password (default). Only
;               the password fields are encrypted, the rest of the session file
;               stays readable. Copy the files and know the master password to
;               use them on another machine. KiTTY asks you to set the master
;               password the first time it saves a password; -masterpwfile
;               supplies it without a prompt.
;    - dpapi  : protect saved passwords with Windows DPAPI, i.e. this Windows
;               account on this PC. No master password is created and KiTTY
;               never asks for one - so unattended runs need no switch at all -
;               but the passwords do NOT travel: copied to another PC or account
;               they cannot be decrypted. Cannot be combined with -masterpwfile.
;    - legacy : store saved passwords unprotected (plain text) for explicit
;               compatibility/automation/audit setups. INSECURE - anyone who can
;               read the files gets the passwords.
;PortablePasswordProtection=master

; WarnLegacyPasswordUpgrade: in portable mode, warn before a save re-encrypts a
;    password stored in the old unprotected format into the new protected format
;    (old KiTTY releases cannot read the new format). Set to no to skip the
;    warning and re-encrypt silently; the warning dialog can also set this.
;WarnLegacyPasswordUpgrade=yes

; scriptfilefilter: file-dialog filter for local script files.
;    Default: (*.ksh,*.sh)|*.ksh;*.sh|SQL files (*.sql)|*.sql|All files (*.*)|*.*|
;    The example line below narrows it to all files only:
;scriptfilefilter=All files (*.*)|*.*|

; scriptmode: master switch for the RuTTY script engine (send a script file
;    line by line, with wait-for-prompt/halt-on patterns). no = disable the
;    engine entirely: the session auto-script does not run and the
;    "Send a script file" menu entry refuses with a notice.
;scriptmode=yes

; shortcuts: enable/disable KiTTY's keyboard shortcuts. These are the ones
;    that work in a TERMINAL WINDOW - the [Shortcuts] section below binds
;    them, and they are what the Ctrl+Shift+letter predefined commands ride
;    on. Set no if they clash with a full-screen program inside the terminal
;    (Midnight Commander is the usual example) and the key should reach the
;    host instead.
;    It does not affect the configuration box: Ctrl+F and Ctrl+G there are a
;    separate mechanism and keep working either way. Nor does it affect the
;    per-session global hotkey, which is registered with Windows.
;shortcuts=yes

; size: append the live terminal size, e.g. [24x80] (rows x columns), to the
;    window title. Updates as you resize; hidden while maximized. Needs
;    wintitle=yes (the default).
;size=no

; slidedelay: delay in seconds before automatic image switching in slideshow mode
;    0 means no automatic slide, waiting for keyboard event
;slidedelay=0

; shrinkbitmap: shrink large background images to fit the terminal area
;shrinkbitmap=no

; sshversion: the client version string KiTTY announces to the SSH server.
;    Default (unset): PuTTY-KiTTY - KiTTY's own identifier. Some servers reject a
;    non-standard client-version string; set this to a common OpenSSH banner so
;    KiTTY looks like a stock client. Use a current OpenSSH version, e.g.:
;sshversion=OpenSSH_10.0

; transparency: enable/disable the transparency feature
;transparency=yes

; userpasssshnosave: if yes, SSH password will not be saved internally (and can't be reused automatically) 
;userpasssshnosave=no

; winroll: double-click the title bar to roll the window up into the title bar
;   alone, and double-click again to restore it. Ctrl+F12 does the same (see
;   [Shortcuts] rollup), as does the /winroll command.
;winroll=yes

; WinSCPPath: the full path to the winscp.exe binary: 
;WinSCPPath=

; winscpdir: legacy fallback directory containing WinSCP.exe (prefer WinSCPPath)
;winscpdir=

; wintitle: enable KiTTY's window-title decorations: the live size suffix
;    (size=yes) and the (PROTECTED) / (ONTOP) status markers. no = plain stock
;    titles. Unlike classic KiTTY the title text is never parsed, only
;    decorated - the old remote title-command channel stays removed.
;wintitle=yes

; zmodem: enable ZModem transfers (the sz/rz commands). The switch gates both
;   the ZModem Receive/Upload/Abort entries in the terminal's Tools menu and
;   the Connection > ZModem configuration panel: with it off, neither appears.
;   On by default; set it to no to hide both.
;zmodem=yes



[Shortcuts]

; list: the keys that have a user-defined action, separated by spaces. Each
;    name listed here needs its own <key>=<text to send> line below, so
;    "list={F5} {CONTROL}{F6}" expects a {F5}= and a {CONTROL}{F6}= line.
;    Without the name in this list the key line is never read.
;list={F5} {CONTROL}{F6}

; Shortcuts: definition for the menu shortcuts keys

; (re)send automatic command (default is SHIFT+F12)
;autocommand=

; Change settings ...
;changesettings=

; Clear scrollback
;clearscrollback=

; Clear log file
;clearlogfile=

; Close and restart current session
;closerestart=

; run a local command (default is CONTROL+F5)
;command=

; Copy all window buffers to clipboard
;copyall=

; Open a duplicate window (with same session settings)
;duplicate=

; open text editor connected to the main window (default is SHIFT+F2)
;editor=

; open text editor with clipboard content, connected to the main window (default is CONTROL+SHIFT+F2)
;editorclipboard=

; Show event log
;eventlog=

; Switch font to black on white colors
;fontblackandwhite=

; Decrease font size
;fontdown=

; Switch font to negative colors
;fontnegative=

; Increase font size
;fontup=

; Switch to full screen
;fullscreen=

; receive a remote file with pscp.exe: the full path must be selected in clipboard (default is CONTROL+F4)
;getfile=

; change the background image (default is CONTROL+F11)
;imagechange=

; special command box (default is CONTROL+F8)
;input=

; special command with multi-line editor (default is SHIFT+F8)
;inputm=

; Repeat key exchange
;keyexchange=

; New session ...
;opennew=

; Inherit New Session: a new configuration box carrying the current settings.
;    In quick connect (see [ConfigBox] loadlastsession) the host name comes with
;    them, selected and ready to be edited into the next machine; otherwise the
;    box opens without a host.
;opennewcurrent=

; Print current clipboard content (default if SHIFT+F7)
;print=

; Print all window buffer content (default is F7)
;printall=

; Protect the window, disable keyboard and mouse input (default is CONTROL+F9)
;protect=

; Reset terminal
;resetterminal=

; Roll-up the window into the title bar (default is CONTROL+F12)
;rollup=

; Load a local script and run it remotely (default is CONTROL+F2)
;script=

; Send a local file with pscp.exe (default is CONTROL+F3)
;sendfile=

; Show current port forwarding definition (default is SHIFT+F6)
;showportforward=

; Enable or disable logging (default is SHIFT+F5)
;switchlogmode=

; Send the window to the system tray (default is CONTROL+F6)
;tray=

; Switch to embedded image viewer (default SHIFT+F11)
;viewer=

; Switch to always visible (default is CONTROL+F7)
;visible=

; Start WinSCP (default is SHIFT+F3)
;winscp=



[Print]

; height: characters size (Printing)
;height=100

; maxline: maximum number of lines per page
;maxline=60

; maxchar: maximum number of characters per line
;maxchar=85



[Launcher]

; alreadyRunCheck: what a second launcher does when one is already running.
;    Unset (the default) the second one exits silently. yes = exit as well,
;    stated explicitly. Any other value lets it start anyway, which is only
;    useful when you deliberately want two launcher windows.
;    One case ignores this setting entirely: a launcher started to HOLD
;    workplace proxy mode. The launcher window class is shared by every
;    KiTTY on the machine, while workplace mode is per installation - so a
;    portable copy or a second install already in the tray owns that class,
;    and a launcher started to arm OUR install would exit here without
;    arming anything. Holding the arming therefore exempts it from the
;    check. Two launchers of the SAME install still cannot both arm: the
;    arming refuses a second holder, and that one exits like any duplicate.
;alreadyRunCheck=yes

; classname: override the Win32 window class the launcher registers and
;    looks for. Only worth setting to keep two KiTTY installations from
;    recognising each other as "already running".
;classname=KiTTYLauncher

; reload: enable session list reload on each menu respawn
;reload=yes

; exitwithworkplace: close the launcher again when workplace proxy mode is
; switched off (default yes). Only applies to a launcher that the mode itself
; started, by switching the mode on when none was running - a launcher you
; started yourself always keeps running, because it is also your session list
; and your hotkeys. Set no to keep the started one too.
;exitwithworkplace=yes

; noticeseconds: how long the workplace proxy mode notice stays on screen
; (default 15). It is a window of our own rather than a tray balloon precisely
; so that this is ours to set: Windows has ignored the requested balloon
; duration since Vista, and a balloon cannot carry the mode's colour.
;noticeseconds=15


[Agent]

; kageant (the SSH agent) settings. kageant finds this file on its own:
; %KITTY_INI_FILE%, else kitty.ini/putty.ini next to kageant.exe, else
; %APPDATA%\KiTTY\kitty.ini / %APPDATA%\PuTTY\putty.ini. When the file
; says [KiTTY] savemode=file or savemode=dir, the ini is the authoritative
; store: the tray toggles write back here and the registry is never touched
; (portable mode). A portable folder counts even without the savemode
; line: with savemode absent, a Sessions folder or KiTTYState file next
; to the ini also makes it authoritative. Otherwise (savemode=registry,
; or absent with no such layout) the registry stays authoritative and
; these keys act as first-run defaults only.

; askconfirmation: prompt before a loaded key may sign:
;   yes  = every key use
;   auto = only keys whose comment contains "confirmation" (default)
;   no   = never - also disables the per-key comment prompts (automation)
;askconfirmation=auto

; messageonkeyusage: tray balloon naming the key after each signature
; messageonkeyusage covers key USE (signatures) and, over IPC, key ADD /
; REMOVE / REMOVE-ALL naming the requesting program - a notice, never a
; prompt, so it does not break scripted ssh-add.
;messageonkeyusage=yes

; noticetimeout: how long the kageant notices stay on screen, in
; seconds (2-120). One knob for all of them (key used, key added/
; removed over IPC, startup keys missing). Absent = each notice's own
; default. Hovering the pointer over a notice holds it open regardless.
;noticetimeout=8

; --- IPC access control (all default no). These restrict only requests
; that arrive from OTHER programs over the agent protocol (WM_COPYDATA /
; the named pipe, which is also what the Windows-OpenSSH integration
; uses); the kageant window's own Add/Remove buttons are never affected.
; Signing and listing keys are always allowed; re-encrypting a key is
; allowed even under lockdown (it only tightens a key by dropping its
; cleartext).
; lockdownmode: refuse ALL key add/remove/remove-all over IPC.
;lockdownmode=no
; blockipcadd / blockipcremove: refuse just adds, or just removes.
;blockipcadd=no
;blockipcremove=no

; loadkeysonstartup: re-add the remembered keys when kageant starts, added
;    encrypted so the passphrase is asked on first use, not at login. Only the
;    key FILE PATHS are remembered - never a passphrase or key material - and
;    the list below is maintained for you as you add and remove keys.
;    Off by default. Was called loadonstartup; the old name is read once and
;    rewritten under this one.
;    Note the tray item and the Settings checkbox are labelled "Start kageant
;    at login": today that one command does both jobs - it installs the login
;    autostart AND turns this on - and whether it looks ticked is decided by
;    the autostart itself (the Run entry or Startup shortcut, checked to be
;    THIS kageant), not by this setting.
;loadkeysonstartup=no

; startupkey1, startupkey2, ...: the remembered key files, in order. Paths
; under this install folder are stored relative to it (so they travel); a
; trailing ",encrypted" loads that key deferred. kageant writes these when
; you load keys with loadonstartup on - you normally do not edit them by hand.
;startupkey1=keys\id_ed25519.ppk,encrypted

; --- Startup keys on removable media.
; retrykeys: when a drive appears, load the startup keys that were not there
; at login (they wait as "not loaded" rows in the key list rather than being
; dropped). Default yes - it does nothing unless a startup key is actually
; missing.
;retrykeys=yes
; unloadonremove: when the media a key came from goes away, drop that key
; from the agent and put it back on the pending list, so it returns when the
; media does. Default no, deliberately: pulling a stick must not break an
; authentication that is running right now.
;unloadonremove=no
; quietmissingkeys: skip the startup notice that counts keys whose media is
; absent (expected, when they live on a stick that is not always plugged
; in). A key file that EXISTS but will not load is still reported - that is
; a broken key, not an absent one.
;quietmissingkeys=no

; passphrasecacheseconds: how long a typed passphrase is kept (encrypted in
; memory) to unlock further keys of a batch add without retyping it.
; 0 = do not cache; capped at 300. Default 60.
;passphrasecacheseconds=60

; keylistgeometry / keylistcolumns: the key-list window's remembered
; position/size and column widths. kageant writes these itself when the
; window is moved, resized or closed - not knobs to edit by hand.
;keylistgeometry=
;keylistcolumns=


[FontFallback]

; Font fallback: when the terminal font is missing a character (box drawing,
; Nerd Font icons, CJK, symbols...), KiTTY probes a list of fallback fonts
; and draws that character from the first font that has it. Cell widths are
; unchanged; only the glyph's source font differs. Rendering is plain GDI,
; so emoji come out monochrome. NB: section and key names in this file are
; case-sensitive.

; active: master switch for the whole feature
;active=yes

; fallback: comma-separated list of font names to try, in order, before the
; built-in defaults (Cascadia Mono, Cascadia Code, Segoe UI Symbol, Segoe UI
; Emoji, Segoe UI Historic, Microsoft YaHei UI, Microsoft JhengHei UI,
; Yu Gothic UI, Malgun Gothic). Naming a built-in just promotes it. Fonts
; that are not installed are skipped. Start the list with ! to REPLACE the
; built-in defaults instead.
;fallback=Symbols Nerd Font Mono,JetBrains Mono
;fallback=!MyOnlyFont1,MyOnlyFont2

; override: force a Unicode range (or single codepoint, hex) to a specific
; font regardless of probe results; multiple entries separated by ;
;override=E000-F8FF:Symbols Nerd Font Mono;1F600-1F64F:Segoe UI Emoji

; log: off|error|warn|info|debug|trace - troubleshooting log, written to
; fontfallback.log next to kitty.exe (debug/trace are high volume)
;log=off

; logfile: where to write that log instead of the default. Unset, it goes to
;    fontfallback.log in the folder the running executable sits in - which is
;    read-only for a normal user under Program Files, so a per-user install or
;    a portable copy gets the file and an installed one may not. Give a full
;    path to put it somewhere writable, e.g. %USERPROFILE%\fontfallback.log
;    spelled out (this file does not expand environment variables).
;    The file is appended to, and one previous copy is kept alongside it
;    with a .1 suffix.
;logfile=
