/*
 * kitty.rc - resource script for the KiTTY target.
 * Mirrors putty.rc but additionally embeds the per-session icon set
 * (IDI_MAINICON_0..IDI_MAINICON_49 + IDI_NOCON) used by SetNewIcon().
 */
#include "rcstuff.h"
#include "putty-rc.h"
#include "../kitty/kitty_text.h"

#define APPNAME "KiTTY"
#define APPDESC "SSH, Telnet, Rlogin, and SUPDUP client"

/* The application icon is embedded ONCE. It used to be embedded five times
 * (IDI_MAINICON, IDI_CFGICON, IDI_MAINICON_0, 9901, 9902 - the same 168 KB
 * file under five ids; windres does not dedupe), which was three quarters of
 * the exe's resource section. IDI_CFGICON is not embedded: dialog.c falls
 * back to IDI_MAINICON when it is missing. 9901/9902 are aliases of
 * IDI_MAINICON in kitty_rc_additions.h. IDI_MAINICON_0 stays a separate
 * copy because the per-session set 1..50 must keep its numbering (an
 * external icon DLL may supply it) and id 1 is also the icon Explorer shows. */
IDI_MAINICON ICON "kitty_pp_windows.ico"

/* KiTTY per-session icon set */
IDI_MAINICON_0 ICON "kitty_icons/icon_0.ico"
IDI_MAINICON_1 ICON "kitty_icons/icon_1.ico"
IDI_MAINICON_2 ICON "kitty_icons/icon_2.ico"
IDI_MAINICON_3 ICON "kitty_icons/icon_3.ico"
IDI_MAINICON_4 ICON "kitty_icons/icon_4.ico"
IDI_MAINICON_5 ICON "kitty_icons/icon_5.ico"
IDI_MAINICON_6 ICON "kitty_icons/icon_6.ico"
IDI_MAINICON_7 ICON "kitty_icons/icon_7.ico"
IDI_MAINICON_8 ICON "kitty_icons/icon_8.ico"
IDI_MAINICON_9 ICON "kitty_icons/icon_9.ico"
IDI_MAINICON_10 ICON "kitty_icons/icon_10.ico"
IDI_MAINICON_11 ICON "kitty_icons/icon_11.ico"
IDI_MAINICON_12 ICON "kitty_icons/icon_12.ico"
IDI_MAINICON_13 ICON "kitty_icons/icon_13.ico"
IDI_MAINICON_14 ICON "kitty_icons/icon_14.ico"
IDI_MAINICON_15 ICON "kitty_icons/icon_15.ico"
IDI_MAINICON_16 ICON "kitty_icons/icon_16.ico"
IDI_MAINICON_17 ICON "kitty_icons/icon_17.ico"
IDI_MAINICON_18 ICON "kitty_icons/icon_18.ico"
IDI_MAINICON_19 ICON "kitty_icons/icon_19.ico"
IDI_MAINICON_20 ICON "kitty_icons/icon_20.ico"
IDI_MAINICON_21 ICON "kitty_icons/icon_21.ico"
IDI_MAINICON_22 ICON "kitty_icons/icon_22.ico"
IDI_MAINICON_23 ICON "kitty_icons/icon_23.ico"
IDI_MAINICON_24 ICON "kitty_icons/icon_24.ico"
IDI_MAINICON_25 ICON "kitty_icons/icon_25.ico"
IDI_MAINICON_26 ICON "kitty_icons/icon_26.ico"
IDI_MAINICON_27 ICON "kitty_icons/icon_27.ico"
IDI_MAINICON_28 ICON "kitty_icons/icon_28.ico"
IDI_MAINICON_29 ICON "kitty_icons/icon_29.ico"
IDI_MAINICON_30 ICON "kitty_icons/icon_30.ico"
IDI_MAINICON_31 ICON "kitty_icons/icon_31.ico"
IDI_MAINICON_32 ICON "kitty_icons/icon_32.ico"
IDI_MAINICON_33 ICON "kitty_icons/icon_33.ico"
IDI_MAINICON_34 ICON "kitty_icons/icon_34.ico"
IDI_MAINICON_35 ICON "kitty_icons/icon_35.ico"
IDI_MAINICON_36 ICON "kitty_icons/icon_36.ico"
IDI_MAINICON_37 ICON "kitty_icons/icon_37.ico"
IDI_MAINICON_38 ICON "kitty_icons/icon_38.ico"
IDI_MAINICON_39 ICON "kitty_icons/icon_39.ico"
IDI_MAINICON_40 ICON "kitty_icons/icon_40.ico"
IDI_MAINICON_41 ICON "kitty_icons/icon_41.ico"
IDI_MAINICON_42 ICON "kitty_icons/icon_42.ico"
IDI_MAINICON_43 ICON "kitty_icons/icon_43.ico"
IDI_MAINICON_44 ICON "kitty_icons/icon_44.ico"
IDI_MAINICON_45 ICON "kitty_icons/icon_45.ico"
IDI_MAINICON_46 ICON "kitty_icons/icon_46.ico"
IDI_MAINICON_47 ICON "kitty_icons/icon_47.ico"
IDI_MAINICON_48 ICON "kitty_icons/icon_48.ico"
IDI_MAINICON_49 ICON "kitty_icons/icon_49.ico"
IDI_NOCON ICON "kitty_icons/nocon.ico"

// Session-launcher icons (kitty.exe -launcher): IDI_PUTTY_LAUNCH and
// IDI_BLACKBALL (the -oldicon fallback) are both IDI_MAINICON now, see
// kitty_rc_additions.h - the launcher wears the same icon as the suite.

#include "help.rc2"
#include "putty-common.rc2"

/* KiTTY-specific About dialog (handled by KittyAboutProc in kitty_bridge.c) */
IDD_KITTYABOUT DIALOGEX DISCARDABLE 0, 0, 230, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KITTYABOUT_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_CAP_KITTY, IDA_VERSION, 7, 7, 216, 12
    LTEXT           KT_RC_KITTYABOUT_BLURB, -1, 7, 24, 216, 40
    PUSHBUTTON      KT_RC_KITTYABOUT_WEBPAGE, IDC_WEBPAGE, 55, 68, 120, 14
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 90, 96, 50, 16
END

/* Master-password prompt (DPAPI Phase 2). Handled by gui_master_pw_prompt()
 * in kitty/kitty_mpw_gui.c. The template is laid out for the wordy first-time
 * setup; when merely unlocking, the prompt area is shrunk and the confirm row
 * hidden at runtime. */
IDD_MASTERPW DIALOGEX DISCARDABLE 0, 0, 230, 181
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_MASTERPW_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_MPW_PROMPT, 7, 7, 216, 104
    LTEXT           KT_RC_MASTERPW_LABEL, IDC_MPW_EDIT_LBL, 7, 113, 216, 8
    EDITTEXT        IDC_MPW_EDIT, 7, 123, 216, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           KT_RC_MASTERPW_CONFIRM_LABEL, IDC_MPW_CONFIRM_LBL, 7, 137, 216, 8
    EDITTEXT        IDC_MPW_CONFIRM, 7, 147, 216, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 116, 162, 50, 14
    PUSHBUTTON      KT_KITTY_CANCEL, IDCANCEL, 173, 162, 50, 14
END

/* Legacy->protected password migration consent (portable saves; user decision
 * 2026-07: default-on warning, opt-out via kitty.ini WarnLegacyPasswordUpgrade).
 * Handled by gui_legacy_migrate_warn() in kitty/kitty_mpw_gui.c. */
IDD_MIGRATEWARN DIALOGEX DISCARDABLE 0, 0, 260, 102
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_MIGRATEWARN_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_MIGRATEWARN_TEXT, -1, 7, 7, 246, 34
    LTEXT           KT_RC_MIGRATEWARN_QUESTION, -1, 7, 45, 246, 10
    AUTOCHECKBOX    KT_RC_MIGRATEWARN_NOASK, IDC_MIG_NOASK, 7, 61, 246, 10
    DEFPUSHBUTTON   "&Yes", IDOK, 146, 81, 50, 14
    PUSHBUTTON      "&No", IDCANCEL, 203, 81, 50, 14
END

/* Session export: the bundle's own password (design/TASK_export_password.md).
 * Handled by kitty/kitty_bridge.c. Exporting used to CREATE a master password
 * as a side effect; instead the bundle is a transport artifact with its own
 * password, and the store's master password is never touched. The password is
 * readable while typing (Show password), so there is deliberately no confirm
 * field. */
IDD_EXPORTPW DIALOGEX DISCARDABLE 0, 0, 268, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_EXPORTPW_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_EXPORTPW_INTRO, -1, 7, 7, 254, 26
    AUTORADIOBUTTON KT_RC_EXPORTPW_MODEPW, IDC_EXP_MODEPW, 7, 38, 254, 10, WS_GROUP | WS_TABSTOP
    LTEXT           KT_RC_EXPORTPW_PASS_LABEL, IDC_EXP_PASS_LBL, 18, 54, 243, 8
    EDITTEXT        IDC_EXP_PASS, 18, 64, 243, 12, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Show password", IDC_EXP_SHOWPW, 18, 80, 243, 10
    AUTORADIOBUTTON KT_RC_EXPORTPW_MODEDPAPI, IDC_EXP_MODEDPAPI, 7, 96, 254, 10
    /* WS_GROUP closes the radio group that starts at IDC_EXP_MODEPW; the
     * selection itself is driven explicitly in the dialog proc, because the
     * password controls sit between the two radios. */
    LTEXT           KT_RC_EXPORTPW_DPAPIWARN, IDC_EXP_DPAPIWARN, 18, 108, 243, 18, WS_GROUP
    DEFPUSHBUTTON   KT_RC_EXPORTPW_EXPORT, IDOK, 154, 129, 50, 14
    PUSHBUTTON      KT_KITTY_CANCEL, IDCANCEL, 211, 129, 50, 14
END

/* Make a portable copy (Application > Migration > KiTTY storage): the
 * same controls as IDD_EXPORTPW, driven by the same dialog proc, but here the
 * password becomes the copy's master password. */
IDD_STOREMOVEPW DIALOGEX DISCARDABLE 0, 0, 268, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_INIMIG_OUT_GROUP
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_STOREMOVEPW_INTRO, -1, 7, 7, 254, 26
    AUTORADIOBUTTON KT_RC_STOREMOVEPW_MODEPW, IDC_EXP_MODEPW, 7, 38, 254, 10, WS_GROUP | WS_TABSTOP
    LTEXT           KT_RC_STOREMOVEPW_PASS_LABEL, IDC_EXP_PASS_LBL, 18, 54, 243, 8
    EDITTEXT        IDC_EXP_PASS, 18, 64, 243, 12, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Show password", IDC_EXP_SHOWPW, 18, 80, 243, 10
    AUTORADIOBUTTON KT_RC_EXPORTPW_MODEDPAPI, IDC_EXP_MODEDPAPI, 7, 96, 254, 10
    LTEXT           KT_RC_STOREMOVEPW_DPAPIWARN, IDC_EXP_DPAPIWARN, 18, 108, 243, 18, WS_GROUP
    DEFPUSHBUTTON   "&Copy", IDOK, 154, 129, 50, 14
    PUSHBUTTON      KT_KITTY_CANCEL, IDCANCEL, 211, 129, 50, 14
END

/* Export summary: shows the bundle password once, with a Copy button - this is
 * the moment the user wants to stash it. Handled by kitty/kitty_bridge.c. */
IDD_EXPORTDONE DIALOGEX DISCARDABLE 0, 0, 268, 123
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_CAP_SESSION_EXPORT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_EXPD_TEXT, 7, 7, 254, 62
    LTEXT           KT_RC_EXPORTDONE_PW_LABEL, IDC_EXPD_PWLBL, 7, 72, 254, 8
    EDITTEXT        IDC_EXPD_PW, 7, 82, 190, 12, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "&Copy", IDC_EXPD_COPY, 203, 82, 58, 12
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 211, 102, 50, 14
END

/* Import password prompt. Raised only when the bundle really carries
 * password-protected values (a DPAPI bundle must never see this dialog), and
 * asked once per import, not per file. IDC_IMP_PROMPT is filled in at runtime
 * so a wrong password can re-ask in place. Handled by kitty/kitty_bridge.c. */
IDD_IMPORTPW DIALOGEX DISCARDABLE 0, 0, 268, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_IMPORTPW_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_IMP_PROMPT, 7, 7, 254, 26
    LTEXT           KT_RC_IMPORTPW_PASS_LABEL, -1, 7, 38, 254, 8
    EDITTEXT        IDC_IMP_PASS, 7, 48, 254, 12, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Show password", IDC_IMP_SHOWPW, 7, 64, 254, 10
    DEFPUSHBUTTON   KT_RC_IMPORTPW_IMPORT, IDOK, 154, 75, 50, 14
    PUSHBUTTON      KT_KITTY_CANCEL, IDCANCEL, 211, 75, 50, 14
END

/* Master-password migration notice. Handled by kitty/kitty_bridge.c. */
IDD_MPWMOVED DIALOGEX DISCARDABLE 0, 0, 300, 178
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_MASTERPW_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_MPWM_TEXT, 7, 7, 286, 114
    EDITTEXT        IDC_MPWM_PATH, 7, 123, 286, 12, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      KT_RC_MPWMOVED_COPY_PATH, IDC_MPWM_COPY, 7, 140, 70, 14
    PUSHBUTTON      KT_RC_MPWMOVED_OPEN_FOLDER, IDC_MPWM_OPEN, 83, 140, 70, 14
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 243, 157, 50, 14
END

/* "Update available / up to date" popup (kitty/kitty_win.c). A real (modeless)
 * dialog so the dialog manager applies the shell font at the correct DPI, like
 * every other KiTTY window. The message area + window are grown to fit the text
 * at runtime; buttons: OK (info case) OR Update now + Later (update case), the
 * unused ones hidden. OK and Later share the same slot (only one is ever shown). */
IDD_UPDATEBOX DIALOGEX DISCARDABLE 0, 0, 244, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_CAP_UPDATE
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_UPD_TEXT, 10, 9, 224, 44
    /* KiTTY: bottom-left, shown only when an update is available - opens that
     * release's GitHub page (rendered notes). Sized to keep the original box
     * dimensions; the other buttons stay put. OK and Later share the far-right
     * slot (only one is ever shown). */
    /* Declared left to right so the Tab order matches the row. */
    PUSHBUTTON      KT_RC_UPDATEBOX_NOTES, IDC_UPD_NOTES, 10, 62, 66, 14
    PUSHBUTTON      KT_RC_UPDATEBOX_UPDATE, IDC_UPD_UPDATE, 128, 62, 58, 14
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 190, 62, 44, 14
    PUSHBUTTON      KT_RC_UPDATEBOX_LATER, IDCANCEL, 190, 62, 44, 14
END

/* KiTTY send-text input boxes: [Shortcuts] input (single line, default
 * Ctrl+F8), inputm (multiline, default Shift+F8) and the masked password
 * variant, plus the InfoBox progress banner. Handled by InputCallBack /
 * InputMultilineCallBack / InputCallBackPassword / InfoCallBack in
 * kitty/kitty.c. The 0.76 originals were ordinals 117-120; 117 collides
 * with PuTTY 0.84's IDD_CA_CONFIG, so they were renumbered (see
 * kitty_rc_additions.h). */
IDD_INPUTBOX DIALOGEX DISCARDABLE 0, 0, 248, 50
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_INPUTBOX_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_INPUTBOX_PROMPT, -1, 7, 7, 184, 13
    EDITTEXT        IDC_RESULT, 7, 20, 184, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 198, 20, 42, 14
END

IDD_INPUTBOXMULTI DIALOGEX DISCARDABLE 0, 0, 248, 100
STYLE DS_CENTER | WS_SYSMENU | WS_CAPTION | WS_BORDER | WS_SIZEBOX
CAPTION KT_RC_INPUTBOX_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_INPUTBOXMULTI_PROMPT, -1, 7, 6, 104, 8
    EDITTEXT        IDC_RESULT, 7, 20, 232, 74, ES_AUTOHSCROLL | ES_AUTOVSCROLL | ES_MULTILINE | ES_WANTRETURN | WS_HSCROLL | WS_VSCROLL
    PUSHBUTTON      KT_WIN_OK, IDB_OK, 115, 3, 42, 14
    PUSHBUTTON      KT_KITTY_CANCEL, IDCANCEL, 165, 3, 42, 14
END

IDD_INPUTBOXPW DIALOGEX DISCARDABLE 0, 0, 248, 50
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_INPUTBOX_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_INPUTBOXPW_PROMPT, -1, 7, 7, 184, 13
    EDITTEXT        IDC_RESULT, 7, 20, 184, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 198, 20, 42, 14
END

/* Window-title placeholders: a modeless reference opened from the Window title
 * field (Window > Behaviour). Modeless on purpose - the list stays on screen
 * while the title is being typed, which a message box cannot do. Filled at
 * runtime by kitty_show_title_placeholders() in kitty/kitty_win.c. */
IDD_TITLEVARS DIALOGEX DISCARDABLE 0, 0, 300, 168
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_SIZEBOX
CAPTION KT_RC_TITLEVARS_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           KT_RC_TITLEVARS_INTRO, -1, 7, 5, 286, 18
    LISTBOX         IDC_TITLEVARS_LIST, 7, 26, 286, 112, LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Copy", IDC_TITLEVARS_COPY, 186, 146, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 243, 146, 50, 14
END

/* A server has asked to READ the local clipboard and have the contents sent to
 * it (design/TASK_clipboard_read_permission.md). Handled by
 * kitty/kitty_osc52.c.
 *
 * Three things about this layout are load-bearing:
 *  - "READ" is in the first line in capitals. People have been trained by the
 *    write prompt to expect the harmless direction, and this is the other one.
 *  - the contents are MASKED. IDC_O52_SUMMARY says how much there is and shows
 *    only the first few characters; the full text appears in IDC_O52_PREVIEW
 *    only after View is pressed, and that control starts hidden. A dialog that
 *    displays a password to answer a question about a password is a bad dialog.
 *  - Deny is DEFPUSHBUTTON and IDCANCEL both, so Return and Escape refuse, and
 *    Allow has no keyboard shortcut of the kind you hit by accident. In "Apply
 *    this decision to", the NARROWEST option is pre-selected by the dialog proc:
 *    a pre-selected wider answer would be a nudge, but leaving all four blank is
 *    worse than either, because the code falls back to "just this request"
 *    anyway and the user cannot see that.
 */
IDD_OSC52READ DIALOGEX DISCARDABLE 0, 0, 300, 231
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_OSC52READ_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_O52_WHAT, 7, 7, 286, 18
    LTEXT           "", IDC_O52_WHERE, 7, 27, 286, 8
    LTEXT           "", IDC_O52_CLAIM, 7, 37, 286, 8
    LTEXT           "", IDC_O52_SUMMARY, 7, 48, 218, 18
    PUSHBUTTON      KT_RC_OSC52READ_VIEW, IDC_O52_VIEW, 235, 48, 58, 14
    EDITTEXT        IDC_O52_PREVIEW, 7, 69, 286, 52, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_VISIBLE
    LTEXT           KT_RC_OSC52READ_APPLY_LABEL, IDC_O52_APPLYLBL, 7, 125, 286, 8
    AUTORADIOBUTTON KT_RC_OSC52READ_ONCE, IDC_O52_ONCE, 14, 136, 279, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_O52_MINUTES, 14, 148, 279, 10
    AUTORADIOBUTTON "", IDC_O52_REQUESTS, 14, 160, 279, 10
    AUTORADIOBUTTON KT_RC_OSC52READ_SESSION, IDC_O52_SESSION, 14, 172, 279, 10
    AUTOCHECKBOX    KT_RC_OSC52READ_ALWAYSDENY, IDC_O52_ALWAYSDENY, 7, 186, 286, 10, WS_GROUP
    LTEXT           "", IDC_O52_COUNTDOWN, 7, 212, 170, 8
    PUSHBUTTON      "&Allow", IDC_O52_ALLOW, 183, 209, 52, 14
    DEFPUSHBUTTON   KT_REMOTE_CLIPBOARD_DENY, IDCANCEL, 241, 209, 52, 14
END

/* Generic notice: a caption, a block of text, and OK. A real dialog rather than a
 * MessageBox because it must GROW TO FIT its text - the height here is only a
 * starting point, kitty_notice_box() expands it at the dialog's font. NOT a DPI
 * matter: a MessageBox is drawn by Windows and scales correctly (see the corrected
 * note in kitty_win.c). */
IDD_NOTICEBOX DIALOGEX DISCARDABLE 0, 0, 260, 90
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_CAP_KITTY
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_NOTICE_TEXT, 10, 9, 240, 56
    DEFPUSHBUTTON   KT_WIN_OK, IDOK, 206, 70, 44, 14
END

/* Yes/No confirmation, with an optional second line drawn in RED. Heights here are
 * a starting point: kitty_confirm_box() grows both text controls to fit and moves
 * the buttons down. "No" is the DEFAULT - this is asked when something is about to
 * be overwritten, so a reflex Return must not confirm it. */
IDD_CONFIRMBOX DIALOGEX DISCARDABLE 0, 0, 280, 111
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_CAP_KITTY
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONFIRM_TEXT, 10, 9, 260, 56
    LTEXT           "", IDC_CONFIRM_WARN, 10, 68, 260, 16
    PUSHBUTTON      "&Yes", IDYES, 166, 89, 50, 14
    DEFPUSHBUTTON   "&No", IDNO, 220, 89, 50, 14
END

IDD_INFOBOX DIALOGEX DISCARDABLE 0, 0, 350, 28
STYLE WS_DLGFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE
CAPTION KT_CAP_KITTY
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_RESULT, 7, 10, 336, 14
END

/* /help command list: a modeless, resizable window, so the reference stays
 * readable while commands are typed into the send-text box (the old modal
 * MessageBox blocked exactly that box). Text is filled in at runtime from the
 * internal_commands[] table; handled by HelpBoxProc in kitty/kitty_commands.c. */
IDD_HELPBOX DIALOGEX DISCARDABLE 0, 0, 330, 238
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_SIZEBOX | WS_MAXIMIZEBOX
CAPTION KT_RC_HELPBOX_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_HELPTEXT, 3, 3, 324, 214, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Close", IDCANCEL, 274, 220, 52, 14
END

#ifndef NO_MANIFESTS
1 RT_MANIFEST "putty.mft"
#endif /* NO_MANIFESTS */
