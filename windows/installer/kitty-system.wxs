<?xml version="1.0" encoding="utf-8"?>
<!--
  KiTTY (this port)  -  SYSTEM-WIDE (per-machine) MSI, built with WiX v5 (`wix build`).
  Installs into "Program Files\KiTTY" for all users (needs admin/UAC).
  For the no-UAC current-user installer see kitty-peruser.wxs.

  WiX v5: NON-ADVERTISED shortcuts (stable target path -> exe's own icon shows;
  stable AppUserModelID so Start/taskbar PINS survive upgrades).
  Build: wix build -arch x64 -bindpath <release-084> -o <out>.msi this.
  Per-machine UpgradeCode (fixed/committed): 69EA2DD5-EF19-4811-B324-EF34CAA6942C
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="KiTTY 0.85.1.1-beta (system-wide install)"
           Manufacturer="KAPPER NETWORK-COMMUNICATIONS GmbH"
           Version="0.85.101"
           UpgradeCode="69EA2DD5-EF19-4811-B324-EF34CAA6942C"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of KiTTY is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="kitty.ico" SourceFile="kitty.exe" />
    <Icon Id="klaunch.ico" SourceFile="putty.ico" />
    <Property Id="ARPPRODUCTICON" Value="kitty.ico" />

    <!-- KiTTY: close any running KiTTY BEFORE the file phase so an in-place
         upgrade never blocks on an in-use kitty.exe. This is the reliable escape
         path for users already on 0.84.1.57/.58: their password sessions (opened
         from the config box via the &filemap conf-passing path) did NOT register
         with the Restart Manager, so RM aborted the upgrade with "critical
         application - reboot necessary" and rolled it back. This runs regardless
         of the running version or session type. EndSessionMessage lets a modern
         KiTTY exit cleanly (WM_ENDSESSION handler saves window placement);
         TerminateProcess is the guaranteed fallback. RebootPrompt=no: never ask
         for a reboot. -->
    <util:CloseApplication Id="CloseKitty"   Target="kitty.exe"       CloseMessage="no" EndSessionMessage="yes" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseKageant" Target="kageant.exe"     CloseMessage="no" EndSessionMessage="yes" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="ClosePterm"   Target="kitty_pterm.exe" CloseMessage="no" EndSessionMessage="yes" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseTel"     Target="kitty_tel.exe"   CloseMessage="no" EndSessionMessage="yes" TerminateProcess="1" RebootPrompt="no" />

    <!-- KiTTY: there was a SetProperty here suppressing the Restart Manager's
         RESTART leg for SYSTEM-context deployments (SCCM, Intune, a SYSTEM
         scheduled task), where there is no interactive desktop to relaunch into.
         REMOVED 2026-08-03 as unprovable dead weight. It could not have been
         doing its job:

         MSIDISABLERMRESTART only has an effect if it is set BEFORE the Restart
         Manager session opens. A verbose log of a real `.65 -> .66` silent
         upgrade shows the RM session opening at sequence position 74 while this
         action was scheduled at 191 - far too late. The same log shows the
         property itself DOES work when set in time: passed on the command line
         seven milliseconds before the RM session opened, no "Previously shut down
         applications have been restarted" line appears and the open windows stay
         closed. And in the only context where this action fired at all (SYSTEM,
         session 0) there is no desktop, so its effect could never be observed
         there either.

         Deployers who want the behaviour can pass MSIDISABLERMRESTART=1 on the
         command line, which is where it demonstrably works.

         NOT re-added without deciding the real question first: SHOULD AN UPGRADE
         RELAUNCH THE USER'S TERMINAL WINDOWS AT ALL? Setting the property early
         enough to work (Property table, or an action before the RM session)
         applies to EVERY install, user-context included - so nobody's windows
         would ever come back after an upgrade. That is a product decision, not a
         bug fix, and it is parked until someone actually asks for it. -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="KiTTY" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutDir" Name="KiTTY" />
    </StandardDirectory>

    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component><File Source="kitty.exe" /></Component>
      <Component><File Source="klink.exe" /></Component>
      <Component><File Source="kscp.exe" /></Component>
      <Component><File Source="ksftp.exe" /></Component>
      <Component><File Source="kageant.exe" /></Component>
      <Component><File Source="kittygen.exe" /></Component>
      <Component><File Source="kittygen-cli.exe" /></Component>
      <Component><File Source="kitty_pterm.exe" /></Component>
      <Component><File Source="kitty_tel.exe" /></Component>
      <Component><File Source="kitty.ini.example" /></Component>
    </ComponentGroup>

    <DirectoryRef Id="ShortcutDir">
      <Component Id="c_shortcuts" Guid="B1B2C3D4-0085-4005-9002-000000000001">
        <Shortcut Id="sc_kitty" Name="KiTTY" Target="[INSTALLFOLDER]kitty.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTY" />
        </Shortcut>
        <Shortcut Id="sc_kittygen" Name="KiTTYgen (key generator)" Target="[INSTALLFOLDER]kittygen.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTYgen" />
        </Shortcut>
        <Shortcut Id="sc_kageant" Name="Kageant (SSH agent)" Target="[INSTALLFOLDER]kageant.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.Kageant" />
        </Shortcut>
        <Shortcut Id="sc_ksftp" Name="KSFTP (sftp)" Target="[INSTALLFOLDER]ksftp.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KSFTP" />
        </Shortcut>
        <Shortcut Id="sc_pterm" Name="KiTTY pterm" Target="[INSTALLFOLDER]kitty_pterm.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTYpterm" />
        </Shortcut>
        <Shortcut Id="sc_tel" Name="KiTTY Telnet" Target="[INSTALLFOLDER]kitty_tel.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTYTelnet" />
        </Shortcut>
        <Shortcut Id="sc_launcher" Name="KiTTY Launcher" Target="[INSTALLFOLDER]kitty.exe" Arguments="-launcher" Icon="klaunch.ico" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTYLauncher" />
        </Shortcut>
        <RemoveFolder Id="rm_ShortcutDir" Directory="ShortcutDir" On="uninstall" />
        <!-- Shortcut bookkeeping lives under Software\kapper.net\KiTTY-installer,
             a SIBLING of the application's own hive, never inside it: the
             per-user MSI writes its KeyPaths at INSTALL time, and creating the
             app hive before first run would disarm the first-run restore/adopt
             logic; /delreg deletes the app subtree and savemode=file renames
             it, either of which would silently destroy KeyPaths placed there.
             All GUIDs in this file are NEW with this key (component rules:
             a KeyPath change is a new component); the old
             Software\KiTTY-0.84-port key is removed below - HKLM ONLY. The
             HKCU copy of that key belongs to the per-user package (its
             components' KeyPaths), so this package must not touch it even to
             clean up: a not-yet-upgraded per-user install would break. -->
        <RegistryValue Root="HKLM" Key="Software\kapper.net\KiTTY-installer" Name="smdir" Type="string" Value="" KeyPath="yes" />
        <RemoveRegistryKey Root="HKLM" Key="Software\KiTTY-0.84-port" Action="removeOnInstall" />
        <RemoveRegistryKey Root="HKLM" Key="Software\kapper.net\KiTTY-installer" Action="removeOnUninstall" />
      </Component>
    </DirectoryRef>

    <!-- Startup-folder shortcut: auto-run the tray launcher at login. NOTE: this
         is a per-machine (ALLUSERS) MSI, so MSI redirects StartupFolder to the
         ALL-USERS Startup (%ProgramData%\...\Startup) - the launcher therefore
         autostarts for every account on the machine. The per-user MSI installs
         the same shortcut into just the installing user's Startup. -->
    <StandardDirectory Id="StartupFolder">
      <!-- HKLM, like this component's two siblings: a per-machine package with
           an HKCU KeyPath is per-USER bookkeeping on a machine-wide shortcut -
           installed-state answers wrong for every account but the installing
           one, an uninstall run by another admin can leave the shortcut behind,
           and the shortcut-property write ran in a context that does not own
           the target folder (warning 1946 on some machines). The GUID is NEW
           because a KeyPath change under the same GUID breaks the component
           rules. The old HKCU value is deliberately NOT deleted anywhere in
           this package: the per-user MSI uses the same value as ITS KeyPath,
           and both packages may be installed at once. -->
      <Component Id="c_startup_launcher" Guid="B1B2C3D4-0085-4005-9002-000000000003">
        <Shortcut Id="sc_startup_launcher" Name="KiTTY Launcher" Target="[INSTALLFOLDER]kitty.exe" Arguments="-launcher" Icon="klaunch.ico" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTYLauncher" />
        </Shortcut>
        <RegistryValue Root="HKLM" Key="Software\kapper.net\KiTTY-installer" Name="startuplauncher" Type="string" Value="" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="c_desktop" Guid="B1B2C3D4-0085-4005-9002-000000000002">
        <Shortcut Id="sc_desktop" Name="KiTTY" Target="[INSTALLFOLDER]kitty.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="kappernet.KiTTY" />
        </Shortcut>
        <RegistryValue Root="HKLM" Key="Software\kapper.net\KiTTY-installer" Name="desktop" Type="string" Value="" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="KiTTY" Level="1">
      <ComponentGroupRef Id="Binaries" />
      <ComponentRef Id="c_shortcuts" />
      <ComponentRef Id="c_startup_launcher" />
      <ComponentRef Id="c_desktop" />
    </Feature>
  </Package>
</Wix>
