/*
 * Windows resources for Pageant.
 */

#include "rcstuff.h"

#define APPNAME "kageant"
#define APPDESC "kageant (KiTTY SSH authentication agent)"

#include "pageant-rc.h"

#include "help.rc2"

/*
 * HOW BIG A DIALOG MAY BE.
 *
 * The old "must fit 800x600" rule is retired: no current machine has that
 * screen, and it is not what binds any more. DPI SCALING is. A 1920x1080
 * laptop at 150% - a common Windows 11 default on a 14-inch panel - reports
 * 1280x720 LOGICAL pixels to an application, which is less room than the
 * 1366x768 of a decade-old netbook at 100%. The 1080p panel is the smaller
 * desktop of the two, and it is the one people actually have.
 *
 * So the budget is 1280x720 logical, less roughly 60 for the taskbar:
 *
 *     width  <= 1280 logical px
 *     height <=  660 logical px
 *
 * LOGICAL, not physical: the same template is bigger in pixels on a scaled
 * display, so measuring raw pixels on one machine says nothing about whether
 * it fits on anyone else's. Dialog units are not a shortcut either - their
 * size follows the font, so the same DLU count is more pixels at Segoe UI 9
 * than it was at the old 8pt shell font.
 *
 * scripts/qa_window_minsize.ps1 measures every window at its SMALLEST against
 * these numbers, in logical pixels, and fails the build if one does not fit.
 */

IDI_MAINICON ICON "kitty_pp_agent.ico"
/* Tray glyphs, named for the TASKBAR they sit on: 201 (IDI_TRAYICON) is
 * the dark glyph for a light taskbar, 202 the white glyph for a dark
 * one. kageant_tray_icon() picks by SystemUsesLightTheme. */
IDI_TRAYICON ICON "kitty_pp_tray_light.ico"
202 ICON "kitty_pp_tray_dark.ico"

/* The passphrase boxes, in Segoe UI 9 like the rest of kageant. The
 * dialog-unit base is larger with this font, so these are not the old
 * coordinates scaled - they are re-laid out to the same rules the other
 * dialogs follow: a single-line edit is 11 units, which is what puts its text
 * on the line instead of against the top of a taller box, and a line of text
 * is 9. Both are wider than before, because a SHA256 fingerprint had no room
 * on one line at the old width. */
IDD_LOAD_PASSPHRASE DIALOGEX DISCARDABLE 0, 0, 240, 74
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant: Loading Encrypted Key"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CTEXT "Enter passphrase to load key", IDC_PASSPHRASE_STATIC1,
        10, 8, 220, 9
    CTEXT "", IDC_PASSPHRASE_FINGERPRINT, 10, 22, 220, 9
    EDITTEXT IDC_PASSPHRASE_EDITBOX, 10, 36, 220, 11,
        ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "O&K", IDOK, 128, 54, 48, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 182, 54, 48, 14
END

IDD_ONDEMAND_PASSPHRASE DIALOGEX DISCARDABLE 0, 0, 300, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant: Decrypting Stored Key"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CTEXT "A client of kageant wants to use the following encrypted key:",
        IDC_PASSPHRASE_STATIC1, 10, 8, 280, 9
    CTEXT "", IDC_PASSPHRASE_FINGERPRINT, 10, 21, 280, 9
    CTEXT "If you intended this, click in this box to make sure it has",
        IDC_PASSPHRASE_STATIC2, 10, 36, 280, 9
    CTEXT "input focus, then enter the passphrase to decrypt the key.",
        IDC_PASSPHRASE_STATIC3, 10, 46, 280, 9
    EDITTEXT IDC_PASSPHRASE_EDITBOX, 10, 60, 280, 11,
        ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "O&K", IDOK, 128, 78, 48, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 182, 78, 48, 14
    PUSHBUTTON "&Help", IDHELP, 236, 78, 54, 14
END

/* KiTTY: ListView styles for the key list; the winres headers do not
 * reliably define them for the resource compiler. */
#ifndef LVS_REPORT
#define LVS_REPORT 0x0001
#endif
#ifndef LVS_SHOWSELALWAYS
#define LVS_SHOWSELALWAYS 0x0008
#endif

/* KiTTY: WS_THICKFRAME instead of DS_MODALFRAME - the window is resizable,
 * relaid out in WM_SIZE, with the template size as the minimum. */
/* This IS the font round the earlier note deferred - alignment was fixed on
 * the known face first, and Segoe UI 9 comes after it rather than instead of
 * it. Segoe UI 9, not 10: 10 was what made the earlier attempt fall apart,
 * because it grows the dialog unit far enough that hand-placed rows stop
 * lining up at all.
 *
 * The row that needed paying for is the confirm row. Its label and radio
 * buttons were 8 and 10 units tall on tops two units apart, which reads as
 * one line only while the font is small enough to hide the difference; they
 * now share one height and one top, with SS_CENTERIMAGE on the label. */
IDD_KEYLIST DIALOGEX DISCARDABLE 0, 0, 450, 244
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "kageant Key List"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* KiTTY: a real ListView in report mode instead of upstream's owner-drawn
     * listbox with pixel-computed pseudo-columns. Extended styles (full-row
     * select, grid lines) are set at runtime in WM_INITDIALOG. */
    CONTROL "", IDC_KEYLIST_LISTBOX, "SysListView32",
        LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
        10, 10, 420, 155
    PUSHBUTTON "&Add Key", IDC_KEYLIST_ADDKEY, 10, 187, 60, 14
    PUSHBUTTON "Add Key (&encrypted)", IDC_KEYLIST_ADDKEY_ENC, 75, 187, 80, 14
    PUSHBUTTON "Move &Up", IDC_KEYLIST_MOVEUP, 170, 187, 55, 14
    PUSHBUTTON "Move D&own", IDC_KEYLIST_MOVEDOWN, 230, 187, 55, 14
    /* Right-hand buttons END at x=430, the ListView's right edge (10 + 420).
     * They are RIGHT-anchored, so lining them up at the template size lines
     * them up at every size. */
    PUSHBUTTON "Re-e&ncrypt", IDC_KEYLIST_REENCRYPT, 305, 187, 60, 14
    PUSHBUTTON "&Remove", IDC_KEYLIST_REMOVE, 370, 187, 60, 14
    /* Confirm row, pulled up directly under the key buttons. The Resume
     * button lives here because it re-enables THESE confirmations; it is
     * enabled only while they are suppressed (see WM_TIMER). */
    LTEXT "Confirm key use:", IDC_KEYLIST_CONFIRM_LABEL, 10, 204, 66, 14,
        SS_CENTERIMAGE
    AUTORADIOBUTTON "Ever&y use", IDC_KEYLIST_CONFIRM_YES, 80, 204, 62, 14,
        WS_GROUP
    AUTORADIOBUTTON "By key co&mment", IDC_KEYLIST_CONFIRM_AUTO,
        146, 204, 86, 14
    AUTORADIOBUTTON "Ne&ver", IDC_KEYLIST_CONFIRM_NO, 236, 204, 50, 14
    PUSHBUTTON "Stop rejec&ting keys", IDC_KEYLIST_RESUMECONFIRM,
        300, 204, 130, 14
    /* Window / agent actions; New key aligns under Add Key (x=10). */
    PUSHBUTTON "Ne&w key...", IDC_KEYLIST_NEWKEY, 10, 224, 56, 14
    PUSHBUTTON "&Settings...", IDC_KEYLIST_SETTINGS, 72, 224, 56, 14
    /* a&gent, not &agent: A belongs to "&Add Key". With the letter on two
     * controls Alt+A went to THIS one and pressed it (measured 2026-08-12) -
     * the duplicate silently stole the key from Add Key. */
    PUSHBUTTON "Stop a&gent", IDC_KEYLIST_STOPAGENT, 134, 224, 62, 14
    PUSHBUTTON "A&bout", IDC_KEYLIST_ABOUT, 202, 224, 46, 14
    PUSHBUTTON "&Help", IDC_KEYLIST_HELP, 254, 224, 44, 14
    /* KiTTY: straight into the audit-log viewer - RIGHT-anchored, left of
     * Close (which ends at 430, the ListView's right edge). */
    /* &l: g belongs to "Stop a&gent" - the accelerator check caught the
     * collision at build time, which is exactly its job. */
    PUSHBUTTON "Agent &log...", IDC_KEYLIST_AUDITLOG, 318, 224, 56, 14
    DEFPUSHBUTTON "&Close", IDOK, 380, 224, 50, 14
    /* The ini-path line rides beside "Show unavailable keys". It is the one control
     * here that STRETCHES (LEFT|RIGHT|BOTTOM), so it starts narrow and takes
     * every extra pixel the window is given - the Retry button beside it is
     * RIGHT-anchored and simply moves, so the two never meet. */
    /* Same row, one height, one top - the combo lands on 14 whatever the
     * template says, so 14 is what the label and the checkbox beside it take
     * as well. */
    LTEXT "", IDC_KEYLIST_INISTATUS, 285, 170, 40, 14,
        SS_PATHELLIPSIS | SS_CENTERIMAGE
    LTEXT "&Fingerprint type:", IDC_KEYLIST_FPTYPE_STATIC, 10, 170, 64, 14,
        SS_CENTERIMAGE
    COMBOBOX IDC_KEYLIST_FPTYPE, 78, 170, 95, 12, CBS_DROPDOWNLIST
    /* KiTTY: startup entries whose file is absent/broken, shown as rows. The
     * button sits with them: it acts on exactly these rows, says what the
     * checkbox says, and ends at x=430 like every other right-hand control.
     * "Retry", not "Load": the file may still be absent, and the button says so
     * honestly. The trailing "keys" is what stops "Retry unavailable" being read
     * as "retrying is unavailable". &k because R (Remove), U (Move Up), Y (Every
     * use) and T (Stop rejecting keys) are all taken in this dialog. */
    AUTOCHECKBOX "Show unavailable keys", IDC_KEYLIST_SHOWUNAVAIL,
        182, 170, 100, 14
    PUSHBUTTON "Retry unavailable &keys", IDC_KEYLIST_RETRY, 326, 170, 104, 14
END

/* KiTTY: key details. Read-only EDIT controls, not statics, because the
 * point of looking at a fingerprint is usually to copy it and compare it
 * with one somewhere else. Wide enough that a full SHA-256 line fits, and
 * resizable (WS_THICKFRAME) for the ones that still do not.
 *
 * Segoe UI 9. Two consequences of the font, both of which had to be paid
 * for rather than inherited:
 *
 *  - a single-line edit is 11 units tall at this font, not 12, and it draws
 *    its text at the TOP of whatever box it is given - so a box any taller
 *    leaves the text hanging against the border. Its label carries the same
 *    height and SS_CENTERIMAGE, which is what puts the two on one line.
 *  - the labels are WIDER than they were. "Fingerprints:" and "Confirm each
 *    use:" both fitted 52 and 62 units in Tahoma 8 and do not in Segoe UI 9,
 *    so the label column moved out and the edit column moved with it.
 */
IDD_KEYDETAILS DIALOGEX DISCARDABLE 0, 0, 420, 252
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "kageant - key details"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Key:", -1, 10, 10, 58, 11, SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_KEY, 72, 10, 338, 11, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "State:", -1, 10, 26, 58, 11, SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_STATE, 72, 26, 338, 11,
        ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Fingerprints:", -1, 10, 42, 58, 11, SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_FPS, 72, 42, 338, 46,
        ES_READONLY | ES_MULTILINE | ES_AUTOHSCROLL | WS_HSCROLL | WS_VSCROLL
    LTEXT "Comment:", -1, 10, 92, 58, 11, SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_COMMENT, 72, 92, 338, 26,
        ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL
    LTEXT "Loaded from:", -1, 10, 122, 58, 11, SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_PATHS, 72, 122, 278, 56,
        ES_READONLY | ES_MULTILINE | ES_AUTOHSCROLL | WS_VSCROLL
    /* KiTTY: re-point a not-loaded entry whose file is absent or will not
     * parse. Never shown on a mismatch - Accept below owns that case. */
    PUSHBUTTON "&Locate...", IDC_KEYDETAIL_LOCATE, 356, 122, 54, 14
    LTEXT "Lifetime:", IDC_KEYDETAIL_LIFETIME_LBL, 10, 182, 58, 11,
        SS_CENTERIMAGE
    EDITTEXT IDC_KEYDETAIL_LIFETIME, 72, 182, 338, 11,
        ES_READONLY | ES_AUTOHSCROLL
    AUTOCHECKBOX "Load this key &deferred at startup (passphrase at first use)",
        IDC_KEYDETAIL_DEFER, 10, 200, 300, 12
    /* KiTTY: three-valued (none / ask / ask with Windows Hello), so a
     * droplist, not a checkbox. The label keeps the COMBO's height, not the
     * edits' - a combo box sizes its closed height from the font and lands
     * on 14 here, ignoring whatever the template says. */
    LTEXT "Confir&m each use:", IDC_KEYDETAIL_CONFIRM_LBL, 10, 216, 68, 14,
        SS_CENTERIMAGE
    COMBOBOX IDC_KEYDETAIL_CONFIRM, 82, 216, 164, 48,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    /* KiTTY: the ONLY place a changed key file can be accepted. Shown only for
     * a fingerprint mismatch; the startup path used to ask this in a modal at
     * login, where one click ratified a swap. */
    PUSHBUTTON "&Accept this key", IDC_KEYDETAIL_ACCEPT, 10, 232, 90, 15
    /* KiTTY: Hello-protected keys. Protect writes a protected COPY of the
     * key (never rewrites the original); Forget drops ONE source path from
     * the startup list (a deleted plaintext original, a retired stick). */
    PUSHBUTTON "&Protect with Windows Hello...", IDC_KEYDETAIL_PROTECT,
        104, 232, 120, 15
    PUSHBUTTON "For&get a path...", IDC_KEYDETAIL_FORGET, 228, 232, 70, 15
    DEFPUSHBUTTON "&Close", IDOK, 358, 232, 52, 15
END

/* KiTTY: the [Agent] settings dialog, reached from the key list window's
 * Settings button. Confirm-key-use stays as the key list's inline radios
 * (design), so it is deliberately not duplicated here.
 *
 * FOUR PAGES BEHIND ONE TAB STRIP, AND ONE FLAT TEMPLATE: every control on
 * every page is a direct child of this dialog, laid out at overlapping
 * coordinates, and KeySettingsProc shows one page's controls while hiding the
 * rest. The alternative - a child dialog per page - would have moved the
 * controls off this HWND and broken every GetDlgItem/CheckDlgButton call in
 * the read and write paths, for no visible gain.
 *
 * A hidden page's controls are still REAL WINDOWS: they answer
 * EnumChildWindows and GetDlgItem exactly as the visible ones do, and only
 * IsWindowVisible tells them apart. Anything that walks this dialog - a theme
 * pass, a test harness - has to filter, or it finds four pages' worth of
 * controls stacked on top of one another.
 *
 * DIALOGEX with Segoe UI 9 rather than DIALOG with MS Shell Dlg 8: Segoe UI is
 * the system UI font from Vista onwards, while MS Shell Dlg maps to Tahoma,
 * which stopped being the system font in 2006. The dialog-unit base changes
 * with the font (roughly 7x15 instead of 6x13), so the coordinates below are
 * NOT comparable with the older templates in this file.
 *
 * Mixed rows line up by giving BOTH controls the same height and letting the
 * static centre inside it (SS_CENTERIMAGE). That height is 11 - the natural
 * height of one line in an edit box at this font - and it is not a free
 * choice: a single-line edit draws its text at the TOP of its client area,
 * never centred, so a box taller than one line leaves the number hanging
 * against the top border. Measured on a screenshot; the first cut used 14 and
 * looked exactly like that. The one row that keeps 14 is the theme droplist's
 * label, because a combo box sizes its closed height from the font, ignores
 * the template, and lands on 14.
 */
IDD_KEYSETTINGS DIALOGEX DISCARDABLE 0, 0, 300, 208
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant - settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* The tab control is the STRIP ONLY - 18 units tall, not the height of a
     * page - and the page controls sit on the dialog's own background below
     * it rather than inside the control's pane.
     *
     * That is deliberate. SysTabControl32 has no dark theme - no theme class
     * reaches it - so its pane is painted from the light system face whatever
     * it is handed, and a full-height tab control would put a white sheet
     * behind a dark dialog. Only the strip is kept, and in dark mode even the
     * strip is drawn by hand (kitty_theme_attach_tabs); a pane would have to
     * be hand-drawn too for no gain, and losing it is closer to the way
     * Windows 11 draws a tabbed surface anyway.
     *
     * 12 units is the height of the tab items themselves at this font. Any
     * more and the leftover pane shows below them; the measurement is from a
     * screenshot, not from arithmetic on the font metrics. */
    CONTROL "", IDC_SET_TABS, "SysTabControl32",
        TCS_TABS | WS_CHILD | WS_VISIBLE | WS_TABSTOP,
        6, 6, 288, 12

    /* ---- page 0: Agent ---- */
    AUTOCHECKBOX "Register as Windows &OpenSSH agent", IDC_SET_OPENSSH,
        16, 28, 268, 12
    AUTOCHECKBOX "&Start kageant at login", IDC_SET_STARTUP,
        16, 44, 268, 12
    AUTOCHECKBOX "Load remembered &keys at startup", IDC_SET_LOADKEYS,
        16, 60, 268, 12
    AUTOCHECKBOX "&Notify when a key is used", IDC_SET_NOTIFY,
        16, 76, 268, 12
    LTEXT "Notice &display (seconds):", IDC_SET_L_NOTICE,
        16, 94, 108, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_NOTICESECS, 128, 94, 34, 11, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "blank = each notice's own default", IDC_SET_L_NOTICEHINT,
        168, 94, 116, 11, SS_CENTERIMAGE
    LTEXT "&Colour theme:", IDC_SET_L_THEME,
        16, 114, 108, 14, SS_CENTERIMAGE
    COMBOBOX IDC_SET_THEME, 128, 114, 100, 80,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Dark needs Windows 10 1809 or newer; anything older stays light.",
        IDC_SET_L_THEMEHINT, 16, 134, 268, 10

    /* ---- page 1: Security ---- */
    AUTOCHECKBOX "&Lock down: refuse ALL key add/remove over IPC",
        IDC_SET_LOCKDOWN, 16, 28, 268, 12
    AUTOCHECKBOX "Block &adding keys over IPC", IDC_SET_BLOCKADD,
        16, 44, 268, 12
    AUTOCHECKBOX "Block re&moving keys over IPC", IDC_SET_BLOCKREMOVE,
        16, 60, 268, 12
    AUTOCHECKBOX "Confirmations require Windows &Hello", IDC_SET_HELLO,
        16, 76, 268, 12
    LTEXT "&Passphrase cache (seconds):", IDC_SET_L_TTL,
        16, 96, 120, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_TTL, 140, 96, 34, 11, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "0 = do not cache; blank = the default 60; maximum 300 (5 min). Keys that share a passphrase then load with one prompt.",
        IDC_SET_L_TTLHINT, 16, 114, 268, 20
    LTEXT "Windows Hello cach&e (seconds):", IDC_SET_L_HELLOTTL,
        16, 138, 120, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_HELLOTTL, 140, 138, 34, 11, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "One Hello covers a batch; 0 = every unlock asks; blank = the default 60. Maximum 300.",
        IDC_SET_L_HELLOTTLHINT, 16, 156, 268, 10

    /* ---- page 2: Removable media ---- */
    LTEXT "&Retry startup keys to load, when a drive appears:",
        IDC_SET_L_RETRY, 16, 28, 268, 10
    COMBOBOX IDC_SET_RETRY, 16, 42, 220, 80,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Unload a key when its media is removed", IDC_SET_UNLOAD,
        16, 66, 268, 12
    AUTOCHECKBOX "Do not &warn about missing startup keys", IDC_SET_QUIET,
        16, 82, 268, 12

    /* ---- page 3: Log ---- */
    AUTOCHECKBOX "Wr&ite the agent log", IDC_SET_AGENTLOG,
        16, 28, 268, 12
    LTEXT "&File (blank = default):", IDC_SET_L_LOGPATH,
        16, 46, 88, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_AGENTLOGPATH, 108, 46, 176, 11, ES_AUTOHSCROLL
    /* Where a blank File box actually puts the log. Filled in at
     * WM_INITDIALOG - the path depends on whether this install is portable -
     * because "blank = default" tells nobody where the file is.
     * SS_PATHELLIPSIS drops the MIDDLE of a path too long to fit, so the file
     * name survives; plain ellipsis would cut off the part being looked for. */
    LTEXT "", IDC_SET_L_LOGDEFAULT, 108, 60, 176, 10, SS_PATHELLIPSIS
    /* Alt+K belongs to "Load remembered &keys at startup" on the first page.
     * The accelerator check is per DIALOG, not per page, and it is right to
     * be: Alt+letter reaches a hidden page's control just as well as a
     * visible one, so the letters have to be unique across all four. */
    LTEXT "Rota&te at (KB):", IDC_SET_L_LOGKB,
        16, 78, 60, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_AGENTLOGKB, 80, 78, 36, 11, ES_NUMBER
    LTEXT "&Generations:", IDC_SET_L_LOGKEEP,
        132, 78, 52, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_AGENTLOGKEEP, 188, 78, 28, 11, ES_NUMBER
    LTEXT "E&xpunge rotated logs after (days, 0 = keep):", IDC_SET_L_LOGDAYS,
        16, 98, 158, 11, SS_CENTERIMAGE
    EDITTEXT IDC_SET_AGENTLOGDAYS, 178, 98, 32, 11, ES_NUMBER
    LTEXT "The log is evidence, not proof - see the manual.",
        IDC_SET_L_LOGNOTE, 16, 118, 268, 10

    DEFPUSHBUTTON "OK", IDOK, 182, 188, 54, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 188, 54, 15
END

/* KiTTY: the audit-log viewer - modeless (a log window is left open for an
 * hour, and a modal one would stop the agent answering), resizable, with a
 * live filter. */
/*
 * Segoe UI 9 rather than MS Shell Dlg 8, which maps to Tahoma. The dialog
 * units get about 15% larger with the font, and the numbers below were NOT
 * rescaled to compensate: the window is resizable, remembers its own
 * geometry, and lays itself out from anchors, so the template size is only
 * the first size it is ever shown at. What DOES follow from the template is
 * the minimum size, which grows by the same 15% - which is right, because the
 * text inside it grew too.
 *
 * The toolbar row is unaffected for the same reason it always was: its
 * heights are snapped at runtime to whatever the font makes a closed combo
 * box, not taken from these numbers.
 */
IDD_AUDITVIEW DIALOGEX DISCARDABLE 0, 0, 460, 260
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "kageant - agent log"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ONE toolbar row: every control starts at y=6 and the edit and
     * buttons share the same 13-DLU height (a closed combo box sizes
     * itself from the font and lands on the same height). The first cuts
     * mixed 12/13/14-tall controls on 5/6/7 tops and read as three rows -
     * measured on a screenshot, not a guess. */
    /* The template positions here are only a first approximation: at
     * WM_INITDIALOG every control of this row is snapped to the SAME
     * pixel top and height (the combo's natural height - see the
     * row-aligner in AuditViewProc). Dialog-unit rounding cannot deliver
     * that; measured screenshots kept proving it. */
    LTEXT "&Filter:", IDC_AUDIT_FILTER_LBL, 8, 6, 22, 14, SS_CENTERIMAGE
    EDITTEXT IDC_AUDIT_FILTER, 32, 6, 110, 14, ES_AUTOHSCROLL
    LTEXT "&App:", IDC_AUDIT_APP_LBL, 150, 6, 18, 14, SS_CENTERIMAGE
    COMBOBOX IDC_AUDIT_REQFILTER, 170, 6, 90, 90,
        CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Logging", IDC_AUDIT_ENABLE, 268, 6, 44, 14
    PUSHBUTTON "&Refresh", IDC_AUDIT_REFRESH, 352, 6, 46, 14
    DEFPUSHBUTTON "&Close", IDOK, 404, 6, 48, 14
    CONTROL "", IDC_AUDIT_LIST, "SysListView32",
        LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER |
        WS_TABSTOP, 8, 24, 444, 178
    /* KiTTY: the drill-down. The list's first level stays human (comment,
     * exe name); selecting a row shows its FULL raw record here -
     * fingerprints, requester path, every field - copyable. Double-click
     * opens the same record formatted one field per line (IDD_AUDITDETAIL). */
    EDITTEXT IDC_AUDIT_DETAIL, 8, 206, 444, 38,
        ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_AUDIT_PATH, 8, 248, 444, 10, SS_PATHELLIPSIS
END

/* KiTTY: one audit record, unfolded - every field on its own line, all of
 * it selectable for copying (fingerprints, the requester's full path). */
IDD_AUDITDETAIL DIALOGEX DISCARDABLE 0, 0, 330, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "kageant - agent log record"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* The window has always had WS_THICKFRAME and never had anything that
     * responded to it: dragging it larger left the text box and the button
     * at their template size in the corner. AuditDetailProc anchors them
     * now - the box takes all four edges, Close rides the bottom right. */
    EDITTEXT IDC_AUDITDETAIL_TEXT, 8, 8, 314, 154,
        ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "&Close", IDOK, 270, 168, 52, 15
END

/* Accelerators used: cl */
/* The text box scrolls if the About text ever outgrows it - cheap
 * insurance whatever the dialog font is. */
/* kageant's OWN About box, not a shared one - kitty and kittygen each carry
 * their own IDD_ABOUT in their own .rc, so the font here changes this window
 * and nothing else. */
IDD_ABOUT DIALOGEX DISCARDABLE 140, 40, 270, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About kageant"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* The three buttons share a row and a height. Close is right-aligned to
     * the text box's right edge (10 + 250), the other two run from its left. */
    DEFPUSHBUTTON "&Close", IDOK, 208, 120, 52, 15
    PUSHBUTTON "View &Licence", IDC_ABOUT_LICENCE, 10, 120, 74, 15
    PUSHBUTTON "Visit &Web Site", IDC_ABOUT_WEBSITE, 128, 120, 74, 15
    EDITTEXT IDC_ABOUT_TEXTBOX, 10, 6, 250, 108,
        ES_READONLY | ES_MULTILINE | ES_CENTER | ES_AUTOVSCROLL |
        WS_VSCROLL, WS_EX_STATICEDGE
END

/* No accelerators used */
IDD_LICENCE DIALOGEX DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KiTTY Licence"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 141, 219, 48, 14

    /* KiTTY: WS_VSCROLL - our licence text is longer than upstream's and
     * could not be scrolled without it */
    EDITTEXT IDC_LICENCE_TEXTBOX, 10, 10, 306, 200,
        ES_READONLY | ES_MULTILINE | ES_LEFT | WS_VSCROLL, WS_EX_STATICEDGE
END

#include "version.rc2"

#ifndef NO_MANIFESTS
1 RT_MANIFEST "pageant.mft"
#endif /* NO_MANIFESTS */

/* KiTTY: protect a key with Windows Hello - writes a protected COPY beside
 * the original and its .hello sidecar; the original is never touched. */
/* Segoe UI 9. Every label/edit row here is a MIXED row, which is the case a
 * template gets wrong by default: the edit draws its text at the TOP of its
 * box, so the box has to BE one line (11 units), and the label beside it
 * carries the edit's own top and height plus SS_CENTERIMAGE so the two sit on
 * the same line. Labels are also wider than before - "Recovery passphrase:"
 * does not fit in 60 units of this font. */
IDD_HELLOPROTECT DIALOGEX DISCARDABLE 0, 0, 420, 322
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant - protect a key with Windows Hello"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Key file:", -1, 10, 10, 80, 11, SS_CENTERIMAGE
    EDITTEXT IDC_HP_SRC, 94, 10, 316, 11, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Protected copy:", -1, 10, 26, 80, 11, SS_CENTERIMAGE
    EDITTEXT IDC_HP_DEST, 94, 26, 246, 11, ES_AUTOHSCROLL
    PUSHBUTTON "&Browse...", IDC_HP_BROWSE, 346, 25, 64, 14
    LTEXT "Current passphrase:", IDC_HP_SRCPASS_LBL, 10, 44, 80, 11,
        SS_CENTERIMAGE
    EDITTEXT IDC_HP_SRCPASS, 94, 44, 220, 11, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX "&Use the current passphrase as the recovery passphrase",
        IDC_HP_USESRCPASS, 94, 60, 310, 11
    LTEXT "Recovery passphrase:", IDC_HP_RECPASS_LBL, 10, 76, 80, 11,
        SS_CENTERIMAGE
    EDITTEXT IDC_HP_RECPASS, 94, 76, 220, 11, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Confirm:", IDC_HP_RECPASS2_LBL, 10, 92, 80, 11, SS_CENTERIMAGE
    EDITTEXT IDC_HP_RECPASS2, 94, 92, 220, 11, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX "&No recovery passphrase - Windows Hello and the printed secret only",
        IDC_HP_HELLOONLY, 94, 110, 310, 11
    AUTOCHECKBOX "&Replace this key's startup entry with the protected copy",
        IDC_HP_REPLACE, 94, 125, 310, 11
    AUTOCHECKBOX "Printout is a recover&y code bound to the .hello file (not",
        IDC_HP_SIDEBOUND, 94, 140, 310, 11
    LTEXT "the key's passphrase - it opens nothing without the file)",
        -1, 106, 153, 298, 9
    LTEXT "", IDC_HP_WARN, 10, 168, 400, 128
    PUSHBUTTON "&Open folder", IDC_HP_OPENFOLDER, 10, 300, 70, 14
    DEFPUSHBUTTON "&Protect", IDOK, 286, 300, 58, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 350, 300, 60, 14
END

