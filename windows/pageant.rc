/*
 * Windows resources for Pageant.
 */

#include "rcstuff.h"

#define APPNAME "kageant"
#define APPDESC "kageant (KiTTY SSH authentication agent)"

#include "pageant-rc.h"

#include "help.rc2"

IDI_MAINICON ICON "pageant.ico"
IDI_TRAYICON ICON "pageants.ico"

IDD_LOAD_PASSPHRASE DIALOG DISCARDABLE 0, 0, 140, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant: Loading Encrypted Key"
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT "Enter passphrase to load key", IDC_PASSPHRASE_STATIC1, 10, 6, 120, 8
    CTEXT "", IDC_PASSPHRASE_FINGERPRINT, 10, 16, 120, 8
    EDITTEXT IDC_PASSPHRASE_EDITBOX, 10, 26, 120, 12,
        ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "O&K", IDOK, 20, 42, 40, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 80, 42, 40, 14
END

IDD_ONDEMAND_PASSPHRASE DIALOG DISCARDABLE 0, 0, 250, 78
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant: Decrypting Stored Key"
FONT 8, "MS Shell Dlg"
BEGIN
    CTEXT "A client of kageant wants to use the following encrypted key:",
        IDC_PASSPHRASE_STATIC1, 10, 6, 230, 8
    CTEXT "", IDC_PASSPHRASE_FINGERPRINT, 10, 16, 230, 8
    CTEXT "If you intended this, click in this box to make sure it has",
        IDC_PASSPHRASE_STATIC2, 10, 26, 230, 8
    CTEXT "input focus, then enter the passphrase to decrypt the key.",
        IDC_PASSPHRASE_STATIC3, 10, 34, 230, 8
    EDITTEXT IDC_PASSPHRASE_EDITBOX, 10, 44, 230, 12,
        ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "O&K", IDOK, 45, 60, 40, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 105, 60, 40, 14
    PUSHBUTTON "&Help", IDHELP, 165, 60, 50, 14
END

/* KiTTY: ListView styles for the key list; the winres headers do not
 * reliably define them for the resource compiler. */
#ifndef LVS_REPORT
#define LVS_REPORT 0x0001
#endif
#ifndef LVS_SHOWSELALWAYS
#define LVS_SHOWSELALWAYS 0x0008
#endif

/* KiTTY: WS_THICKFRAME instead of DS_MODALFRAME - the window is resizable,
 * relaid out in WM_SIZE, with the template size as the minimum. */
IDD_KEYLIST DIALOG DISCARDABLE 0, 0, 450, 244
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "kageant Key List"
FONT 8, "MS Shell Dlg"
BEGIN
    /* KiTTY: a real ListView in report mode instead of upstream's owner-drawn
     * listbox with pixel-computed pseudo-columns. Extended styles (full-row
     * select, grid lines) are set at runtime in WM_INITDIALOG. */
    CONTROL "", IDC_KEYLIST_LISTBOX, "SysListView32",
        LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
        10, 10, 420, 155
    PUSHBUTTON "&Add Key", IDC_KEYLIST_ADDKEY, 10, 187, 60, 14
    PUSHBUTTON "Add Key (&encrypted)", IDC_KEYLIST_ADDKEY_ENC, 75, 187, 80, 14
    PUSHBUTTON "Move &Up", IDC_KEYLIST_MOVEUP, 170, 187, 55, 14
    PUSHBUTTON "Move D&own", IDC_KEYLIST_MOVEDOWN, 230, 187, 55, 14
    /* Right-hand buttons END at x=430, the ListView's right edge (10 + 420).
     * They are RIGHT-anchored, so lining them up at the template size lines
     * them up at every size. */
    PUSHBUTTON "Re-e&ncrypt", IDC_KEYLIST_REENCRYPT, 305, 187, 60, 14
    PUSHBUTTON "&Remove", IDC_KEYLIST_REMOVE, 370, 187, 60, 14
    /* Confirm row, pulled up directly under the key buttons. The Resume
     * button lives here because it re-enables THESE confirmations; it is
     * enabled only while they are suppressed (see WM_TIMER). */
    LTEXT "Confirm key use:", IDC_KEYLIST_CONFIRM_LABEL, 10, 207, 62, 8
    AUTORADIOBUTTON "Ever&y use", IDC_KEYLIST_CONFIRM_YES, 76, 206, 60, 10, WS_GROUP
    AUTORADIOBUTTON "By key co&mment", IDC_KEYLIST_CONFIRM_AUTO, 140, 206, 82, 10
    AUTORADIOBUTTON "Ne&ver", IDC_KEYLIST_CONFIRM_NO, 226, 206, 46, 10
    PUSHBUTTON "Stop rejec&ting keys", IDC_KEYLIST_RESUMECONFIRM, 300, 204, 130, 14
    /* Window / agent actions; New key aligns under Add Key (x=10). */
    PUSHBUTTON "Ne&w key...", IDC_KEYLIST_NEWKEY, 10, 224, 56, 14
    PUSHBUTTON "&Settings...", IDC_KEYLIST_SETTINGS, 72, 224, 56, 14
    /* a&gent, not &agent: A belongs to "&Add Key". With the letter on two
     * controls Alt+A went to THIS one and pressed it (measured 2026-08-12) -
     * the duplicate silently stole the key from Add Key. */
    PUSHBUTTON "Stop a&gent", IDC_KEYLIST_STOPAGENT, 134, 224, 62, 14
    PUSHBUTTON "A&bout", IDC_KEYLIST_ABOUT, 202, 224, 46, 14
    PUSHBUTTON "&Help", IDC_KEYLIST_HELP, 254, 224, 44, 14
    DEFPUSHBUTTON "&Close", IDOK, 380, 224, 50, 14
    /* The ini-path line rides beside "Show unavailable keys". It is the one control
     * here that STRETCHES (LEFT|RIGHT|BOTTOM), so it starts narrow and takes
     * every extra pixel the window is given - the Retry button beside it is
     * RIGHT-anchored and simply moves, so the two never meet. */
    LTEXT "", IDC_KEYLIST_INISTATUS, 275, 172, 52, 8, SS_PATHELLIPSIS
    LTEXT "&Fingerprint type:", IDC_KEYLIST_FPTYPE_STATIC, 10, 172, 60, 8
    COMBOBOX IDC_KEYLIST_FPTYPE, 70, 170, 95, 12, CBS_DROPDOWNLIST
    /* KiTTY: startup entries whose file is absent/broken, shown as rows. The
     * button sits with them: it acts on exactly these rows, says what the
     * checkbox says, and ends at x=430 like every other right-hand control.
     * "Retry", not "Load": the file may still be absent, and the button says so
     * honestly. The trailing "keys" is what stops "Retry unavailable" being read
     * as "retrying is unavailable". &k because R (Remove), U (Move Up), Y (Every
     * use) and T (Stop rejecting keys) are all taken in this dialog. */
    AUTOCHECKBOX "Show unavailable keys", IDC_KEYLIST_SHOWUNAVAIL,
        175, 171, 95, 10
    PUSHBUTTON "Retry unavailable &keys", IDC_KEYLIST_RETRY, 332, 169, 98, 14
END

/* KiTTY: key details. Read-only EDIT controls, not statics, because the
 * point of looking at a fingerprint is usually to copy it and compare it
 * with one somewhere else. Wide enough that a full SHA-256 line fits, and
 * resizable (WS_THICKFRAME) for the ones that still do not. */
IDD_KEYDETAILS DIALOG DISCARDABLE 0, 0, 420, 252
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "kageant - key details"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Key:", -1, 10, 12, 52, 8
    EDITTEXT IDC_KEYDETAIL_KEY, 66, 10, 344, 12, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "State:", -1, 10, 28, 52, 8
    EDITTEXT IDC_KEYDETAIL_STATE, 66, 26, 344, 12, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Fingerprints:", -1, 10, 44, 52, 8
    EDITTEXT IDC_KEYDETAIL_FPS, 66, 42, 344, 46,
        ES_READONLY | ES_MULTILINE | ES_AUTOHSCROLL | WS_HSCROLL | WS_VSCROLL
    LTEXT "Comment:", -1, 10, 94, 52, 8
    EDITTEXT IDC_KEYDETAIL_COMMENT, 66, 92, 344, 26,
        ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL
    LTEXT "Loaded from:", -1, 10, 124, 52, 8
    EDITTEXT IDC_KEYDETAIL_PATHS, 66, 122, 344, 56,
        ES_READONLY | ES_MULTILINE | ES_AUTOHSCROLL | WS_VSCROLL
    LTEXT "Lifetime:", IDC_KEYDETAIL_LIFETIME_LBL, 10, 184, 52, 8
    EDITTEXT IDC_KEYDETAIL_LIFETIME, 66, 182, 344, 12,
        ES_READONLY | ES_AUTOHSCROLL
    AUTOCHECKBOX "Load this key &deferred at startup (passphrase at first use)",
        IDC_KEYDETAIL_DEFER, 10, 202, 300, 10
    AUTOCHECKBOX "Ask for confir&mation each time this key is used",
        IDC_KEYDETAIL_CONFIRM, 10, 216, 300, 10
    /* KiTTY: the ONLY place a changed key file can be accepted. Shown only for
     * a fingerprint mismatch; the startup path used to ask this in a modal at
     * login, where one click ratified a swap. */
    PUSHBUTTON "&Accept this key", IDC_KEYDETAIL_ACCEPT, 10, 232, 90, 14
    DEFPUSHBUTTON "&Close", IDOK, 360, 232, 50, 14
END

/* KiTTY: the [Agent] settings dialog, reached from the key list window's
 * Settings button. Confirm-key-use stays as the key list's inline radios
 * (design), so it is deliberately not duplicated here. The removable-media
 * options are honoured only from kitty.ini, so they are greyed in a
 * registry-authoritative (non-portable) install. */
IDD_KEYSETTINGS DIALOG DISCARDABLE 0, 0, 250, 286
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "kageant - settings"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Agent", -1, 8, 4, 234, 86
    AUTOCHECKBOX "Register as Windows &OpenSSH agent", IDC_SET_OPENSSH,
        16, 18, 218, 10
    AUTOCHECKBOX "&Start kageant at login", IDC_SET_STARTUP, 16, 32, 218, 10
    AUTOCHECKBOX "Load remembered &keys at startup", IDC_SET_LOADKEYS,
        16, 46, 218, 10
    AUTOCHECKBOX "&Notify when a key is used", IDC_SET_NOTIFY, 16, 60, 218, 10
    LTEXT "Notice &display (seconds):", -1, 16, 76, 108, 10
    EDITTEXT IDC_SET_NOTICESECS, 126, 74, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "(blank = default)", -1, 172, 76, 66, 10
    GROUPBOX "Security - block other programs over the agent IPC", -1,
        8, 94, 234, 58
    AUTOCHECKBOX "&Lock down: refuse ALL key add/remove over IPC",
        IDC_SET_LOCKDOWN, 16, 108, 220, 10
    AUTOCHECKBOX "Block &adding keys over IPC", IDC_SET_BLOCKADD,
        16, 122, 220, 10
    AUTOCHECKBOX "Block re&moving keys over IPC", IDC_SET_BLOCKREMOVE,
        16, 136, 220, 10
    GROUPBOX "Removable-media keys", -1, 8, 156, 234, 90
    AUTOCHECKBOX "&Retry startup keys when their drive appears",
        IDC_SET_RETRY, 16, 170, 220, 10
    AUTOCHECKBOX "&Unload a key when its media is removed",
        IDC_SET_UNLOAD, 16, 184, 220, 10
    AUTOCHECKBOX "Do not &warn about missing startup keys",
        IDC_SET_QUIET, 16, 198, 220, 10
    LTEXT "&Passphrase cache (seconds):", -1, 16, 216, 108, 10
    EDITTEXT IDC_SET_TTL, 126, 214, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "0 = do not cache; default 60, maximum 300 (5 min).",
        -1, 16, 230, 220, 9
    LTEXT "Keys that share a passphrase then load with one prompt.",
        -1, 16, 240, 220, 9
    DEFPUSHBUTTON "OK", IDOK, 132, 264, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 190, 264, 50, 14
END

/* Accelerators used: cl */
IDD_ABOUT DIALOG DISCARDABLE 140, 40, 270, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About kageant"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 216, 118, 48, 14
    PUSHBUTTON "View &Licence", IDC_ABOUT_LICENCE, 6, 118, 70, 14
    PUSHBUTTON "Visit &Web Site", IDC_ABOUT_WEBSITE, 140, 118, 70, 14
    EDITTEXT IDC_ABOUT_TEXTBOX, 10, 6, 250, 110,
        ES_READONLY | ES_MULTILINE | ES_CENTER, WS_EX_STATICEDGE
END

/* No accelerators used */
IDD_LICENCE DIALOG DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KiTTY Licence"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 148, 219, 44, 14

    /* KiTTY: WS_VSCROLL - our licence text is longer than upstream's and
     * could not be scrolled without it */
    EDITTEXT IDC_LICENCE_TEXTBOX, 10, 10, 306, 200,
        ES_READONLY | ES_MULTILINE | ES_LEFT | WS_VSCROLL, WS_EX_STATICEDGE
END

#include "version.rc2"

#ifndef NO_MANIFESTS
1 RT_MANIFEST "pageant.mft"
#endif /* NO_MANIFESTS */
