/*
 * Windows resources shared between PuTTY and PuTTYtel, to be #include'd
 * after defining appropriate macros.
 *
 * Note that many of these strings mention PuTTY. Due to restrictions in
 * VC's handling of string concatenation, this can't easily be fixed.
 * It's fixed up at runtime.
 *
 * This file has the more or less arbitrary extension '.rc2' to avoid
 * IDEs taking it to be a top-level resource script in its own right
 * (which has been known to happen if the extension was '.rc'), and
 * also to avoid the resource compiler ignoring everything included
 * from it (which happens if the extension is '.h').
 */

/* Accelerators used: clw */
IDD_ABOUTBOX DIALOGEX DISCARDABLE 140, 40, 270, 156
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PuTTY"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 216, 138, 48, 14
    PUSHBUTTON "View &Licence", IDA_LICENCE, 6, 138, 70, 14
    PUSHBUTTON "Visit &Web Site", IDA_WEB, 140, 138, 70, 14
    EDITTEXT IDA_TEXT, 10, 6, 250, 128, ES_READONLY | ES_MULTILINE | ES_CENTER | WS_VSCROLL, WS_EX_STATICEDGE
END

/*
 * Size budget for this and every other dialog: 1280 x 660 LOGICAL pixels.
 * Not the old 800x600 rule - what binds now is DPI scaling. A 1920x1080
 * laptop at 150% reports 1280x720 logical pixels to an application, less room
 * than a 1366x768 netbook at 100%, and the taskbar takes about 60 of the
 * height. Dialog units are no shortcut: their size follows the font, so the
 * same count is more pixels in a larger one. Measured at each window's
 * smallest by scripts/qa_window_minsize.ps1; the note in pageant.rc has the
 * reasoning in full.
 */
/*
 * KiTTY: the PANEL HOST - the window every panel's controls are built into.
 *
 * An embedded child DIALOG rather than a plain child window, for three
 * reasons that all matter: MapDialogRect and the dialog base units work on
 * it, so controls.c lays panels out in dialog units exactly as before;
 * DS_CONTROL with WS_EX_CONTROLPARENT keeps Tab, the arrow keys and the Alt
 * mnemonics working across the boundary; and WS_CLIPCHILDREN means WINDOWS
 * clips the controls to it.
 *
 * That last one is the point. A control scrolled past the bottom is cut off
 * by the host instead of being drawn across the button strip, and scrolling
 * is one ScrollWindow on the host instead of moving forty controls by hand,
 * clipping each with a region and repainting them - which is what four
 * separate rendering faults came out of.
 *
 * Sized and positioned at run time; the numbers here are a placeholder.
 */
IDD_PANELHOST DIALOGEX DISCARDABLE 0, 0, 10, 10
STYLE DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

/* Accelerators used: aco */
IDD_MAINBOX DIALOGEX DISCARDABLE 0, 0, 360, 316
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Configuration"
FONT 9, "Segoe UI", 400, 0, 0x1
CLASS "PuTTYConfigBox"
BEGIN
END

/* Accelerators used: co */
/* KiTTY: larger default + WS_THICKFRAME/WS_MAXIMIZEBOX (resizable; LogProc
 * lays the controls out on WM_SIZE, so the coords here are only the start). */
IDD_LOGBOX DIALOGEX DISCARDABLE 100, 20, 460, 220
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "PuTTY Event Log"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* KiTTY: control order here IS the tab order, and logbox_layout() places
     * them left to right in the same order - Close, Copy, Clear - so Tab and
     * the arrow keys move rightwards. The coordinates below only matter until
     * WM_INITDIALOG lays them out; they are kept in step to avoid misleading
     * anyone reading the template. */
    DEFPUSHBUTTON "&Close", IDOK, 107, 203, 44, 14
    PUSHBUTTON "C&opy", IDN_COPY, 161, 203, 44, 14
    PUSHBUTTON "C&lear", IDN_CLEAR, 215, 203, 44, 14
    /* KiTTY: WS_TABSTOP - without it the list is not in the tab order at all
     * (upstream's line lacks it too), so Tab cycled around the three buttons
     * and could never reach the log itself. Last in the template, so the
     * cycle reads Close, Copy, Clear, log. */
    LISTBOX IDN_LIST, 3, 3, 454, 196, LBS_HASSTRINGS | LBS_USETABSTOPS | WS_VSCROLL | WS_HSCROLL | LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_TABSTOP
END

/* No accelerators used */
IDD_LICENCEBOX DIALOGEX DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KiTTY Licence"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 148, 219, 44, 14

    /* KiTTY: WS_VSCROLL - our licence text is longer than upstream's and
     * could not be scrolled without it */
    EDITTEXT IDA_TEXT, 10, 10, 306, 200, ES_READONLY | ES_MULTILINE | ES_LEFT | WS_VSCROLL, WS_EX_STATICEDGE
END

/* Accelerators used: achio */
IDD_HOSTKEY DIALOGEX DISCARDABLE 50, 50, 340, 240
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Security Alert"
FONT 9, "Segoe UI", 400, 0, 0x1
CLASS "PuTTYHostKeyDialog"
BEGIN
    ICON "", IDC_HK_ICON, 10, 18, 0, 0

    PUSHBUTTON "&Cancel", IDCANCEL, 288, 220, 40, 14
    PUSHBUTTON "&Accept", IDC_HK_ACCEPT, 168, 220, 40, 14
    PUSHBUTTON "Connect &Once", IDC_HK_ONCE, 216, 220, 64, 14
    PUSHBUTTON "More &info...", IDC_HK_MOREINFO, 60, 220, 64, 14
    PUSHBUTTON "&Help", IDHELP, 12, 220, 40, 14

    LTEXT "", IDC_HK_TITLE, 40, 20, 300, 12

    EDITTEXT IDC_HK_TEXT, 40, 20, 290, 200, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
END

/* Accelerators used: c */
IDD_HK_MOREINFO DIALOGEX DISCARDABLE 140, 40, 400, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY: information about the server's host key"
FONT 9, "Segoe UI", 400, 0, 0x1
CLASS "PuTTYHostKeyMoreInfo"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 176, 130, 48, 14
END

/* Accelerators used: aco */
IDD_CA_CONFIG DIALOGEX DISCARDABLE 0, 0, 350, 260
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY trusted host certification authorities"
FONT 9, "Segoe UI", 400, 0, 0x1
CLASS "PuTTYConfigBox"
BEGIN
END

#include "version.rc2"
