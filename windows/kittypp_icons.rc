/*
 * kitty++.icl - the session icons, resources only (no code). kitty.exe,
 * kitty_portable.exe and the launcher load it beside themselves as data
 * (kitty_startup.c: [KiTTY] iconfile, else kitty++.icl, else the exe's own
 * icon 0). Window > Title & Icon "Icon (from internal
 * resources)" n shows resource n + 1: icon 0 is the default.
 *
 * Drawn from Microsoft's Fluent UI System Icons (MIT,
 * kitty_icons/FLUENT-LICENSE). Resource n + 1001 is the dark form of
 * icon n where it has one: the session lists take it in dark mode
 * (kitty_sessicon.c).
 */

#include "rcstuff.h"

#define APPNAME "kitty++.icl"
#define APPDESC "KiTTY++ session icons"

