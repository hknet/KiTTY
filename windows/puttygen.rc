/*
 * Windows resources for PuTTYgen.
 */

#include "rcstuff.h"

#define APPNAME "KiTTYgen"
#define APPDESC "KiTTY SSH key generation utility"

#include "help.rc2"
#include "puttygen-rc.h"
#include "../kitty/kitty_text.h"

200 ICON "kitty_pp_keygen.ico"

201 DIALOGEX DISCARDABLE 0, 0, 400, 309
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_CAP_KGEN_TITLE
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

210 DIALOGEX DISCARDABLE 0, 0, 200, 72
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KGPASS_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CTEXT KT_RC_KGPASS_PROMPT, 100, 10, 6, 180, 16
    CTEXT "", 101, 10, 24, 180, 8
    EDITTEXT 102, 10, 34, 180, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "O&K", IDOK, 50, 52, 40, 14
    PUSHBUTTON KT_XFER_BTN_CANCEL, IDCANCEL, 110, 52, 40, 14
END

/* Accelerators used: cl */
213 DIALOGEX DISCARDABLE 140, 40, 270, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KGABOUT_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON KT_XFER_BTN_CLOSE, IDOK, 216, 162, 48, 14
    PUSHBUTTON KT_RC_ABOUT_LICENCE, 101, 6, 162, 70, 14
    PUSHBUTTON KT_RC_ABOUT_WEBSITE, 102, 140, 162, 70, 14
    EDITTEXT 1000, 10, 6, 250, 154, ES_READONLY | ES_MULTILINE | ES_CENTER, WS_EX_STATICEDGE
END

/* No accelerators used */
214 DIALOGEX DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_LICENCE_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON KT_WIN_OK, IDOK, 148, 219, 44, 14

    /* KiTTY: WS_VSCROLL - our licence text is longer than upstream's and
     * could not be scrolled without it */
    EDITTEXT 1000, 10, 10, 306, 200, ES_READONLY | ES_MULTILINE | ES_LEFT | WS_VSCROLL, WS_EX_STATICEDGE
END

215 DIALOGEX DISCARDABLE 0, 0, 259, 93
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KGPPKPARAMS_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT KT_RC_KGPPKPARAMS_PPKVER, IDC_PPKVER_STATIC, 5, 6, 119, 8
    AUTORADIOBUTTON "2", IDC_PPKVER_2, 124, 5, 30, 10, WS_GROUP
    AUTORADIOBUTTON "3", IDC_PPKVER_3, 154, 5, 30, 10
    LTEXT KT_RC_KGPPKPARAMS_KDF, IDC_KDF_STATIC, 5, 20, 119, 8
    AUTORADIOBUTTON "Argon2id", IDC_KDF_ARGON2ID, 124, 19, 45, 10, WS_GROUP
    AUTORADIOBUTTON "Argon2i", IDC_KDF_ARGON2I, 169, 19, 45, 10, WS_GROUP
    AUTORADIOBUTTON "Argon2d", IDC_KDF_ARGON2D, 214, 19, 45, 10
    LTEXT KT_RC_KGPPKPARAMS_MEM, IDC_ARGON2_MEM_STATIC,
        5, 33, 119, 8
    EDITTEXT IDC_ARGON2_MEM, 124, 31, 40, 12
    LTEXT "Kbyte", IDC_ARGON2_MEM_STATIC2, 174, 33, 34, 8
    LTEXT KT_RC_KGPPKPARAMS_TIME, IDC_ARGON2_TIME_STATIC,
        5, 47, 119, 8
    EDITTEXT IDC_ARGON2_TIME, 124, 45, 40, 12
    AUTORADIOBUTTON "ms", IDC_PPK_AUTO_YES, 174, 46, 20, 10, WS_GROUP
    AUTORADIOBUTTON "passes", IDC_PPK_AUTO_NO, 204, 46, 40, 10
    LTEXT KT_RC_KGPPKPARAMS_PARALLEL, IDC_ARGON2_PARALLEL_STATIC,
        5, 61, 119, 8
    EDITTEXT IDC_ARGON2_PARALLEL, 124, 59, 60, 12
    DEFPUSHBUTTON "O&K", IDOK, 70, 75, 40, 14
    PUSHBUTTON KT_XFER_BTN_CANCEL, IDCANCEL, 134, 75, 40, 14
END

/* Accelerators used: clw */
216 DIALOGEX DISCARDABLE 140, 40, 450, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KGCERTINFO_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
CLASS "PuTTYgenCertInfo"
BEGIN
    DEFPUSHBUTTON KT_XFER_BTN_CLOSE, IDOK, 201, 130, 48, 14
END

#include "version.rc2"

#ifndef NO_MANIFESTS
1 RT_MANIFEST "puttygen.mft"
#endif /* NO_MANIFESTS */


/* KiTTY: the sidecar door editor - a protected key's .hello, listed and
 * editable (remove a machine, add this computer). */
IDD_KGHELLODOORS DIALOGEX DISCARDABLE 0, 0, 360, 190
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION KT_RC_KGHELLODOORS_CAPTION
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT KT_RC_HELLOPROTECT_KEYFILE, -1, 10, 10, 40, 8
    EDITTEXT IDC_HD_FILE, 52, 8, 298, 12, ES_READONLY | ES_AUTOHSCROLL
    LTEXT KT_RC_KGHELLODOORS_INTRO, -1, 10, 26, 200, 8
    LISTBOX IDC_HD_LIST, 10, 38, 340, 100,
        LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON KT_RC_KGHELLODOORS_REMOVE, IDC_HD_REMOVE, 10, 144, 100, 14
    PUSHBUTTON KT_RC_KGHELLODOORS_ADD, IDC_HD_ADD, 118, 144, 100, 14
    LTEXT KT_RC_KGHELLODOORS_NOTE1,
        -1, 10, 162, 340, 9
    LTEXT KT_RC_KGHELLODOORS_NOTE2,
        -1, 10, 171, 340, 9
    DEFPUSHBUTTON KT_XFER_BTN_CLOSE, IDOK, 300, 144, 50, 14
END
