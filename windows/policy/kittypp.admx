<?xml version="1.0" encoding="utf-8"?>
<!-- KiTTY++ Group Policy template. Copy kittypp.admx to %SystemRoot%\PolicyDefinitions
     and en-US\kittypp.adml to %SystemRoot%\PolicyDefinitions\en-US (or to the
     domain's Central Store). Values are written to Software\Policies\kapper.net\KiTTY++
     under HKLM (Computer Configuration) or HKCU (User Configuration). HKLM takes precedence. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
