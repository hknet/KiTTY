# tools/fixed-arrays.allow - the fixed character arrays that stay fixed.
#
# tools/check-fixed-arrays.py, run by the build, fails on every char-like
# array (char, wchar_t, WCHAR, TCHAR, BYTE, uint8_t ...) sized with MAX_PATH
# or 256 bytes or more that has no line here, and on every line here whose
# array no longer exists. A path or a value from outside belongs in memory
# sized to it, not in such an array; a line here gives the reason this size
# is safe (a protocol or API size, a value Windows bounds, a length checked
# before the copy, a test fixture).
#
# One line per array:  file | function or struct | name | size | reason
#   function "name()", member "struct name" / "union name", inside a
#   #define "#define NAME", file scope "(file)"; size as written in the
#   source (spaces do not matter). Matched by these four fields, never by
#   line number; two arrays with the same four fields need two lines.
#   Lines of upstream PuTTY code start their reason with "upstream:".
# Order: by file, then source order - for reading only.


charset/internal.h | struct sbcs_data | ucs2sbcs | 256 | upstream: charset table / test buffer of the charset library

charset/utf8.c | utf8_read_test() | str | 512 | upstream: charset table / test buffer of the charset library
charset/utf8.c | utf8_write_test() | str | 512 | upstream: charset table / test buffer of the charset library

cmdgen.c | (file) | kwev_last_error | 256 | last error text for kittygen-cli Event Log record, vsnprintf to sizeof

cmdline.c | kitty_cmdline_use_stored_password() | pw | KITTY_PW_MAX + 1 | password/secret buffer sized to KITTY_PW_MAX (the suite-wide password limit, 4096)
cmdline.c | cmdline_process_param() | readbuf | 4096 | upstream: fread chunk of a password/key file, size passed
cmdline.c | kitty_masterpwfile_apply() | line | 1024 | line of a master-password file (a secret), byte loop bounded by sizeof-1
cmdline.c | kitty_masterpwfile_apply() | who | 300 | owning account name "DOMAIN\user" from kitty_secret_file_check (account and domain names are bounded by Windows), size passed

config.c | conf_password_editbox_handler() | pw | KITTY_PW_MAX + 1 | password/secret buffer sized to KITTY_PW_MAX (the suite-wide password limit, 4096)

contrib/cygtermd/pty.c | (file) | ptyname | FILENAME_MAX | upstream: pty device name from ptsname (Cygwin, /dev/ptyN), strncpy FILENAME_MAX-1; contrib, not built

contrib/cygtermd/sel.c | struct bufchain_granule | buf | BUFFER_GRANULE | upstream: bufchain granule (contrib, not built)
contrib/cygtermd/sel.c | sel_iterate() | buf | 65536 | upstream: read() chunk, size passed (contrib, not built)

crypto/arcfour.c | struct ArcfourContext | s | 256 | upstream: cipher state / key material / encoded block of fixed algorithm size
crypto/arcfour.c | arcfour_setkey() | k | 256 | upstream: cipher state / key material / encoded block of fixed algorithm size

crypto/argon2.c | struct blk | data | 1024 | upstream: cipher state / key material / encoded block of fixed algorithm size

crypto/mlkem.c | mlkem_keygen_rho_sigma() | ek | 1568 | upstream: cipher state / key material / encoded block of fixed algorithm size
crypto/mlkem.c | mlkem_keygen_rho_sigma() | dk | 1536 | upstream: cipher state / key material / encoded block of fixed algorithm size
crypto/mlkem.c | mlkem_encaps_internal() | c | 1568 | upstream: cipher state / key material / encoded block of fixed algorithm size
crypto/mlkem.c | mlkem_decaps() | c_regen | 1568 | upstream: cipher state / key material / encoded block of fixed algorithm size

crypto/openssh-certs.c | opensshcert_time_to_iso8601() | buf | 256 | upstream: cipher state / key material / encoded block of fixed algorithm size

dialog.c | ctrl_settitle() | pathbuf | 256 | configuration-tree panel path ("Session/Logging"), not a file path; kitty_panel_path_resolve bounded to sizeof
dialog.c | ctrl_getset() | pathbuf | 256 | configuration-tree panel path, not a file path; kitty_panel_path_resolve bounded to sizeof

